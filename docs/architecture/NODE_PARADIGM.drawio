  <diagram name="2 Inside one instance" id="node-paradigm-1">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1001" value="Inside one self-hosted instance. One box can host any mix of node types, many users, and many of each. The Individual Node is the base that every other type builds on." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=14;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="20" width="1200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c1002" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=2;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="40" y="90" width="1040" height="740" as="geometry" />
        </mxCell>
        <mxCell id="c1003" value="ONE SELF-HOSTED INSTANCE  (Raspberry Pi, home server, VPS or a community machine)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="60" y="98" width="900" height="24" as="geometry" />
        </mxCell>
        <mxCell id="c1004" value="Node types this box hosts (the operator switches each on, and sets its scope)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="60" y="130" width="560" height="20" as="geometry" />
        </mxCell>
        <mxCell id="c1005" value="INDIVIDUAL NODE   always on&lt;br&gt;Personal workspace: calendar, tasks, contacts and CRM, inbox with approval before any send, secret vault, API keys for tools, messenger and calls.&lt;br&gt;Built: yes.   Pipelines and the voice command layer: prototyped on the second machine, not built here." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="60" y="155" width="560" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c1006" value="HOUSEHOLD NODE   optional&lt;br&gt;Shared calendar, tasks and files, family templates, shared contacts, who in the home may see what.&lt;br&gt;Built: no." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="60" y="285" width="560" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c1007" value="ORGANIZATION NODE   optional&lt;br&gt;Members, roles, boards, co-determination, shared records and files, the organization registry.&lt;br&gt;Built: yes, the organizations module (Phase 4). Shared files and CRM: not built." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="60" y="385" width="560" height="95" as="geometry" />
        </mxCell>
        <mxCell id="c1008" value="COMMUNITY NODE   optional&lt;br&gt;The constitutional engine: elections, legislatures, executives, courts, jurisdiction maps, public square and rooms, the hash-chained audit log.&lt;br&gt;Built: yes. Almost all of Statecraft today is this node type, in simulation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="60" y="490" width="560" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c1009" value="Scope per type, set at setup:&lt;br&gt;- who may hold an account here (just me, my household, invited people, residents of a place)&lt;br&gt;- which places or groups the data covers&lt;br&gt;- what is shared outward, and with whom" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="60" y="612" width="560" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c1010" value="Shared by every type on the box" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="650" y="130" width="400" height="20" as="geometry" />
        </mxCell>
        <mxCell id="c1011" value="Permission and consent layer&lt;br&gt;owner-only data, per-user keys, scopes, vault, signed requests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="650" y="155" width="400" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c1012" value="Node identity&lt;br&gt;Ed25519 keys, signed peer requests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="650" y="315" width="400" height="62" as="geometry" />
        </mxCell>
        <mxCell id="c1013" value="Data and queues&lt;br&gt;Postgres with PostGIS, Redis, job queue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="650" y="385" width="400" height="62" as="geometry" />
        </mxCell>
        <mxCell id="c1014" value="Talk&lt;br&gt;Matrix for text, LiveKit for calls, one window for both" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="650" y="455" width="400" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c1015" value="Files and backup&lt;br&gt;local storage, copies on chosen peer nodes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="650" y="535" width="400" height="62" as="geometry" />
        </mxCell>
        <mxCell id="c1016" value="Sync layer&lt;br&gt;what each node shares with which other nodes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="650" y="605" width="400" height="62" as="geometry" />
        </mxCell>
        <mxCell id="c1017" value="Ways in (any screen, any size)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="1110" y="90" width="480" height="20" as="geometry" />
        </mxCell>
        <mxCell id="c1018" value="Phone: installed web app (PWA), native app where possible" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1110" y="120" width="480" height="108" as="geometry" />
        </mxCell>
        <mxCell id="c1019" value="Desktop and laptop: browser or installed web app" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1110" y="240" width="480" height="58" as="geometry" />
        </mxCell>
        <mxCell id="c1020" value="TV: browser or app on the TV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1110" y="310" width="480" height="58" as="geometry" />
        </mxCell>
        <mxCell id="c1021" value="Smart speaker: voice only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
