      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1001" value="Scaling up: many instances, one data-sharing and permission system. A name in the DNS tree maps to a place on the jurisdiction map. Name SHAPES below are SAMPLES: decisions dns-name-shape, dns-foreign-domain-keys and dns-home-node-reach are open in the rubric." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=13;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="20" width="1500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c1002" value="SAMPLE DNS tree (option A, delegated subzones, the desk recommendation). Each community node runs its own zone." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" parent="1" vertex="1">
