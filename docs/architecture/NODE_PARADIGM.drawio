        <mxCell id="c1001" value="The four node types. Every node operator chooses which types this box hosts. The outer circles show what each type is used for." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=14;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="20" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c1002" value="Community Node&lt;br&gt;You use it to keep your communities organized." style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1">
