        <mxCell id="c1020" value="Private notes and tasks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="840" y="144" width="190" height="46" as="geometry" />
