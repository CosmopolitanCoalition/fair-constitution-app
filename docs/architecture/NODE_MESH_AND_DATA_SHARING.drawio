        <mxCell id="c1018" value="Peers I chose (copy)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="1470" y="100" width="110" height="44" as="geometry" />
