          <mxGeometry x="1360" y="144" width="110" height="46" as="geometry" />
        </mxCell>
        <mxCell id="c1025" value="Copy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
