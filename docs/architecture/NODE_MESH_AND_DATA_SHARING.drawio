        <mxCell id="c1020" value="Short forms drop the mesh root. &lt;b&gt;@earth&lt;/b&gt; means earth.worldofstatecraft.org." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;" parent="1" vertex="1">
          <mxGeometry x="60" y="268" width="1300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="c1021" value="FORMS IN USE NOW" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="60" y="310" width="600" height="22" as="geometry" />
        </mxCell>
        <mxCell id="c1022" value="Form" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="60" y="336" width="420" height="34" as="geometry" />
        </mxCell>
        <mxCell id="c1023" value="Meaning" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="480" y="336" width="560" height="34" as="geometry" />
        </mxCell>
        <mxCell id="c1024" value="Sample" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="1040" y="336" width="480" height="34" as="geometry" />
        </mxCell>
        <mxCell id="c1025" value="User@Organization(s).LocalityChain(s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="60" y="370" width="420" height="52" as="geometry" />
        </mxCell>
        <mxCell id="c1026" value="a person on a household or organization box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="480" y="370" width="560" height="52" as="geometry" />
        </mxCell>
        <mxCell id="c1027" value="Joseph@​JDSileo.​mecklenburg.​nc.​usa.​earth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1040" y="370" width="480" height="52" as="geometry" />
        </mxCell>
        <mxCell id="c1028" value="User@LocalityChain(s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="60" y="422" width="420" height="52" as="geometry" />
        </mxCell>
        <mxCell id="c1029" value="a person held by a community box: no box of their own, or a replica" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="480" y="422" width="560" height="52" as="geometry" />
        </mxCell>
        <mxCell id="c1030" value="Maria@​mecklenburg.​nc.​usa.​earth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1040" y="422" width="480" height="52" as="geometry" />
        </mxCell>
        <mxCell id="c1031" value="User@OwnDomain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="60" y="474" width="420" height="52" as="geometry" />
        </mxCell>
        <mxCell id="c1032" value="a domain the holder owns, aliased into the mesh" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="480" y="474" width="560" height="52" as="geometry" />
        </mxCell>
        <mxCell id="c1033" value="Joseph@​jdsileo.​com" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1040" y="474" width="480" height="52" as="geometry" />
        </mxCell>
        <mxCell id="c1034" value="Organization(s)@LocalityChain(s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="60" y="526" width="420" height="52" as="geometry" />
        </mxCell>
        <mxCell id="c1035" value="a group address" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="480" y="526" width="560" height="52" as="geometry" />
        </mxCell>
        <mxCell id="c1036" value="acme@​mecklenburg.​nc.​usa.​earth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1040" y="526" width="480" height="52" as="geometry" />
        </mxCell>
        <mxCell id="c1037" value="User+Unique+Alias@earth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="60" y="578" width="420" height="52" as="geometry" />
        </mxCell>
        <mxCell id="c1038" value="a generated id plus a chosen alias, unique across the mesh. Works like a zip code. People rarely type it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="480" y="578" width="560" height="52" as="geometry" />
        </mxCell>
        <mxCell id="c1039" value="Joseph+Unique+Alias@​earth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1040" y="578" width="480" height="52" as="geometry" />
        </mxCell>
        <mxCell id="c1040" value="LATER: hosted inboxes up the tree (recursive offers)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="60" y="650" width="700" height="22" as="geometry" />
        </mxCell>
        <mxCell id="c1041" value="Joseph+JDSileo@​mecklenburg.​nc.​usa.​earth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="60" y="678" width="700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c1042" value="the county offers to be an inbox for this person" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="760" y="678" width="540" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c1043" value="Joseph+JDSileo+mecklenburg@​nc.​usa.​earth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="60" y="718" width="700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c1044" value="the state offers to be an inbox for all its counties, recursively" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="760" y="718" width="540" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c1045" value="Joseph+JDSileo+mecklenburg+nc@​usa.​earth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="60" y="758" width="700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c1046" value="the country does the same for its states" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="760" y="758" width="540" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c1047" value="Joseph+JDSileo+mecklenburg+nc+usa@​earth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="60" y="798" width="700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c1048" value="the planet does the same for its countries" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="760" y="798" width="540" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c1049" value="Joseph+JDSileo+mecklenburg+nc+usa+earth@​worldofstatecraft.​org" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="60" y="838" width="700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c1050" value="the mesh root does the same for every community" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="760" y="838" width="540" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c1051" value="A person can belong to more than one household or organization. The same name then appears on each: Joseph@JDSileo… and Joseph@acme… . Each box may use its own alias for a place in the chain." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=10;align=left;verticalAlign=top;fontColor=#333333;" parent="1" vertex="1">
          <mxGeometry x="60" y="890" width="1240" height="36" as="geometry" />
        </mxCell>
        <mxCell id="c1052" value="ALIASES&lt;br&gt;A household, organization or community may adopt its own domain or subdomain. It works on every box that agrees to host its data or route to that domain. The alias is managed in the app with the permission rules on the keys." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1560" y="310" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="c1053" value="WHO HOSTS WHAT&lt;br&gt;Whether data is synced, callable, readable or moderated is an agreement between the parties that run the boxes. Hosting a domain carries the community&#39;s agreement to that DNS entry." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1560" y="450" width="480" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c1054" value="SAME RULES FOR SECRETS&lt;br&gt;A personal vault, a household vault, an organization vault and a community vault all follow one model: an owner, a scope, and consent to share. A person&#39;s own vault is the base case." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1560" y="570" width="480" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c1055" value="ROUTING&lt;br&gt;The locality chain is real DNS. A client reads it from the right and connects to the nearest box that offers the datastore. Data goes only where its owner allows." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1560" y="690" width="480" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c1056" value="Built today: none of the DNS tree. The three open questions (name shape, foreign domain keys, home box reach) are in the rubric. Mail server choice waits on them." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="60" y="940" width="1240" height="36" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="6 Naming and internet protocols" id="mesh-8">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1300" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="c1001" value="One name, every protocol. A box serves its own names with the plain internet standards, so any other server or phone can reach it, on or off the mesh. PROPOSED design." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=14;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1900" height="30" as="geometry"/></mxCell>
        <object label="Zoom out: the open mesh" link="data:page/id,mesh-1" id="c1002"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1a73e8;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="260" height="34" as="geometry"/></mxCell></object>
        <mxCell id="c1003" value="Joseph" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="150" height="48" as="geometry"/></mxCell>
        <mxCell id="c1004" value="person" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=9;align=center;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="162" width="150" height="30" as="geometry"/></mxCell>
        <mxCell id="c1005" value="@" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="190" y="110" width="40" height="48" as="geometry"/></mxCell>
        <mxCell id="c1006" value="JDSileo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="230" y="110" width="150" height="48" as="geometry"/></mxCell>
        <mxCell id="c1007" value="box" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=9;align=center;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="230" y="162" width="150" height="30" as="geometry"/></mxCell>
        <mxCell id="c1008" value="mecklenburg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="384" y="110" width="150" height="48" as="geometry"/></mxCell>
        <mxCell id="c1009" value="county" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=9;align=center;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="384" y="162" width="150" height="30" as="geometry"/></mxCell>
        <mxCell id="c1010" value="nc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="538" y="110" width="80" height="48" as="geometry"/></mxCell>
        <mxCell id="c1011" value="state" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=9;align=center;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="538" y="162" width="80" height="30" as="geometry"/></mxCell>
        <mxCell id="c1012" value="usa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="622" y="110" width="90" height="48" as="geometry"/></mxCell>
        <mxCell id="c1013" value="country" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=9;align=center;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="622" y="162" width="90" height="30" as="geometry"/></mxCell>
        <mxCell id="c1014" value="earth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="716" y="110" width="90" height="48" as="geometry"/></mxCell>
        <mxCell id="c1015" value="planet" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=9;align=center;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="716" y="162" width="90" height="30" as="geometry"/></mxCell>
        <mxCell id="c1016" value="worldofstatecraft.org" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="810" y="110" width="260" height="48" as="geometry"/></mxCell>
        <mxCell id="c1017" value="mesh root, or any TLD aliased to it" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=9;align=center;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="810" y="162" width="260" height="30" as="geometry"/></mxCell>
        <mxCell id="c1018" value="The text before the @ is a person. The text after it is a zone in DNS. The zone is the community tree, so the place order and the DNS order are the same." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1080" y="110" width="900" height="44" as="geometry"/></mxCell>
        <mxCell id="c1019" value="WHAT THE NAME DOES ON EACH PROTOCOL" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="215" width="1000" height="22" as="geometry"/></mxCell>
        <mxCell id="c1020" value="Protocol" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="242" width="130" height="32" as="geometry"/></mxCell>
        <mxCell id="c1021" value="Use" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="170" y="242" width="300" height="32" as="geometry"/></mxCell>
        <mxCell id="c1022" value="How it finds the box (DNS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="242" width="330" height="32" as="geometry"/></mxCell>
        <mxCell id="c1023" value="Built here today" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800" y="242" width="300" height="32" as="geometry"/></mxCell>
        <mxCell id="c1024" value="DNS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="274" width="130" height="56" as="geometry"/></mxCell>
        <mxCell id="c1025" value="names the zones and boxes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="170" y="274" width="300" height="56" as="geometry"/></mxCell>
        <mxCell id="c1026" value="each community box serves its own zone. A and AAAA records point to the box. Delegation goes from parent to child." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="274" width="330" height="56" as="geometry"/></mxCell>
        <mxCell id="c1027" value="No. Only the Caddy public overlay exists." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="800" y="274" width="300" height="56" as="geometry"/></mxCell>
        <mxCell id="c1028" value="HTTPS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="130" height="56" as="geometry"/></mxCell>
        <mxCell id="c1029" value="web profile and the app" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="170" y="330" width="300" height="56" as="geometry"/></mxCell>
        <mxCell id="c1030" value="Joseph.JDSileo.mecklenburg... A certificate per zone by ACME. A wildcard covers one label only." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="330" width="330" height="56" as="geometry"/></mxCell>
        <mxCell id="c1031" value="Yes for one host (Caddy). Not per zone." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="800" y="330" width="300" height="56" as="geometry"/></mxCell>
        <mxCell id="c1032" value="SMTP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="386" width="130" height="56" as="geometry"/></mxCell>
        <mxCell id="c1033" value="mail in and out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="170" y="386" width="300" height="56" as="geometry"/></mxCell>
        <mxCell id="c1034" value="MX record for JDSileo.mecklenburg... plus SPF, DKIM and DMARC records." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="386" width="330" height="56" as="geometry"/></mxCell>
        <mxCell id="c1035" value="No. Mail server choice is held." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="800" y="386" width="300" height="56" as="geometry"/></mxCell>
        <mxCell id="c1036" value="IMAP or JMAP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="442" width="130" height="56" as="geometry"/></mxCell>
        <mxCell id="c1037" value="mail apps read the inbox" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="170" y="442" width="300" height="56" as="geometry"/></mxCell>
        <mxCell id="c1038" value="SRV record _imaps._tcp. The native inbox stays the source." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="442" width="330" height="56" as="geometry"/></mxCell>
        <mxCell id="c1039" value="No. Native inbox screens only." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="800" y="442" width="300" height="56" as="geometry"/></mxCell>
        <mxCell id="c1040" value="SIP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="498" width="130" height="56" as="geometry"/></mxCell>
        <mxCell id="c1041" value="calls to and from outside" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="170" y="498" width="300" height="56" as="geometry"/></mxCell>
        <mxCell id="c1042" value="SRV and NAPTR records. sip:Joseph@JDSileo... A carrier number routes into the box PBX." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="498" width="330" height="56" as="geometry"/></mxCell>
        <mxCell id="c1043" value="No. Deferred in the roadmap." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="800" y="498" width="300" height="56" as="geometry"/></mxCell>
        <mxCell id="c1044" value="Matrix" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="554" width="130" height="56" as="geometry"/></mxCell>
        <mxCell id="c1045" value="chat between boxes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="170" y="554" width="300" height="56" as="geometry"/></mxCell>
        <mxCell id="c1046" value="SRV or .well-known on the name. Boxes federate by consent." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="554" width="330" height="56" as="geometry"/></mxCell>
        <mxCell id="c1047" value="Matrix and .well-known: yes. Per zone: no." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="800" y="554" width="300" height="56" as="geometry"/></mxCell>
        <mxCell id="c1048" value="WebRTC and TURN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="130" height="56" as="geometry"/></mxCell>
        <mxCell id="c1049" value="calls and screens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="170" y="610" width="300" height="56" as="geometry"/></mxCell>
        <mxCell id="c1050" value="LiveKit on the box. TURN on its own subdomain for boxes behind routers." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="610" width="330" height="56" as="geometry"/></mxCell>
        <mxCell id="c1051" value="LiveKit: yes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="800" y="610" width="300" height="56" as="geometry"/></mxCell>
        <mxCell id="c1052" value="RTMP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="666" width="130" height="56" as="geometry"/></mxCell>
        <mxCell id="c1053" value="live streams in and out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="170" y="666" width="300" height="56" as="geometry"/></mxCell>
        <mxCell id="c1054" value="live.JDSileo... takes a stream key. Publish to or take from other platforms." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="666" width="330" height="56" as="geometry"/></mxCell>
        <mxCell id="c1055" value="No. LiveKit offers an ingress service. Not set up." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="800" y="666" width="300" height="56" as="geometry"/></mxCell>
        <mxCell id="c1056" value="CalDAV and CardDAV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="722" width="130" height="56" as="geometry"/></mxCell>
        <mxCell id="c1057" value="outside calendar and contact apps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="170" y="722" width="300" height="56" as="geometry"/></mxCell>
        <mxCell id="c1058" value="SRV records and .well-known/caldav. Reads the native calendar and CRM." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="722" width="330" height="56" as="geometry"/></mxCell>
        <mxCell id="c1059" value="No. Native screens and API only." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="800" y="722" width="300" height="56" as="geometry"/></mxCell>
        <mxCell id="c1060" value="WebFinger" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="778" width="130" height="56" as="geometry"/></mxCell>
        <mxCell id="c1061" value="who is this name" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="170" y="778" width="300" height="56" as="geometry"/></mxCell>
        <mxCell id="c1062" value="GET /.well-known/webfinger?resource=acct:Joseph@JDSileo... returns the links the person chose to publish." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="778" width="330" height="56" as="geometry"/></mxCell>
        <mxCell id="c1063" value="No." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="800" y="778" width="300" height="56" as="geometry"/></mxCell>
        <mxCell id="c1064" value="PRACTICAL LIMITS OF A HOME BOX&lt;br&gt;Many home internet plans block inbound port 25 and mail from a home address is often rejected. A box behind carrier NAT cannot be reached from outside. Home addresses change. Each is solved by a relay or smarthost run by a community box, which moves mail and traffic but holds no readable copy. This is the open decision dns-home-node-reach." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="1060" height="110" as="geometry"/></mxCell>
        <mxCell id="c1065" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=2;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1150" y="215" width="910" height="750" as="geometry"/></mxCell>
        <mxCell id="c1066" value="EXTERNAL PROFILES AND PUBLIC LINES" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1170" y="223" width="860" height="22" as="geometry"/></mxCell>
        <mxCell id="c1067" value="PERSONAL profile&lt;br&gt;Joseph@JDSileo..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1170" y="270" width="230" height="56" as="geometry"/></mxCell>
        <mxCell id="c1068" value="ORGANIZATION or HOUSEHOLD profile&lt;br&gt;acme@mecklenburg..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1170" y="346" width="230" height="56" as="geometry"/></mxCell>
        <mxCell id="c1069" value="COMMUNITY profile&lt;br&gt;mecklenburg.nc.usa.earth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1170" y="422" width="230" height="56" as="geometry"/></mxCell>
        <mxCell id="c1070" value="PROFILE CARD&lt;br&gt;HTTPS page and WebFinger answer. Only the fields the owner publishes. Each field has an audience (page 8)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1480" y="330" width="230" height="90" as="geometry"/></mxCell>
        <mxCell id="c1071" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;startArrow=classic;" edge="1" parent="1" source="c1067" target="c1070"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1072" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;startArrow=classic;" edge="1" parent="1" source="c1068" target="c1070"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1073" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;startArrow=classic;" edge="1" parent="1" source="c1069" target="c1070"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1074" value="Other mail servers" style="shape=mxgraph.networks.cloud;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1770" y="270" width="280" height="56" as="geometry"/></mxCell>
        <mxCell id="c1075" value="SMTP" style="endArrow=classic;html=1;rounded=0;strokeColor=#4a7fb5;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;startArrow=classic;" edge="1" parent="1" source="c1070" target="c1074"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1076" value="Public phone network (carrier line)" style="shape=mxgraph.networks.cloud;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1770" y="346" width="280" height="56" as="geometry"/></mxCell>
        <mxCell id="c1077" value="SIP trunk" style="endArrow=classic;html=1;rounded=0;strokeColor=#4a7fb5;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;startArrow=classic;" edge="1" parent="1" source="c1070" target="c1076"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1078" value="Social networks and the fediverse" style="shape=mxgraph.networks.cloud;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1770" y="422" width="280" height="56" as="geometry"/></mxCell>
        <mxCell id="c1079" value="WebFinger, ActivityPub, API" style="endArrow=classic;html=1;rounded=0;strokeColor=#4a7fb5;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;startArrow=classic;" edge="1" parent="1" source="c1070" target="c1078"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1080" value="Other Matrix servers" style="shape=mxgraph.networks.cloud;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1770" y="498" width="280" height="56" as="geometry"/></mxCell>
        <mxCell id="c1081" value="Matrix federation" style="endArrow=classic;html=1;rounded=0;strokeColor=#4a7fb5;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;startArrow=classic;" edge="1" parent="1" source="c1070" target="c1080"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1082" value="Streaming platforms" style="shape=mxgraph.networks.cloud;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1770" y="574" width="280" height="56" as="geometry"/></mxCell>
        <mxCell id="c1083" value="RTMP" style="endArrow=classic;html=1;rounded=0;strokeColor=#4a7fb5;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;startArrow=classic;" edge="1" parent="1" source="c1070" target="c1082"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1084" value="The keys and tokens for each outside service sit in the owner's vault (built). A household, an organization and a community each have their own vault under the same model." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1170" y="520" width="560" height="70" as="geometry"/></mxCell>
        <mxCell id="c1085" value="CONTACT EXCHANGE BY SHARED NETWORKS" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1170" y="625" width="860" height="22" as="geometry"/></mxCell>
        <mxCell id="c1086" value="1  Each side lists the kinds of outside network it is willing to disclose, with no handles yet." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1170" y="655" width="870" height="50" as="geometry"/></mxCell>
        <mxCell id="c1087" value="2  The two nodes show the kinds both sides have: for example a public phone line, a fediverse account, a Matrix server." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1170" y="713" width="870" height="50" as="geometry"/></mxCell>
        <mxCell id="c1088" value="3  Each person approves which handle to hand over for each shared kind." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1170" y="771" width="870" height="50" as="geometry"/></mxCell>
        <mxCell id="c1089" value="4  The contact is saved in the CRM with the shared handles. Removing a link removes the handle on both sides." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1170" y="829" width="870" height="50" as="geometry"/></mxCell>
        <mxCell id="c1090" value="Default: nothing is disclosed. Public lines, such as sales@acme... or a main phone number, are published on purpose and route to the box that answers them." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=10;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1170" y="893" width="870" height="40" as="geometry"/></mxCell>
        <mxCell id="c1091" value="Built today: HTTPS through Caddy for one host, Matrix well-known, federation discovery, per-user vault and scoped keys. Not built: any per-zone DNS, SMTP, SIP, RTMP, WebFinger, profile cards, contact exchange." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=10;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="975" width="2000" height="30" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="7 Peer circles and the short path" id="mesh-7">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1300" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="c1001" value="Households and organizations can form their own community directly, with no physical community box in the middle. Data takes the shortest path and stays on the boxes of the people involved. PROPOSED design." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=14;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1800" height="30" as="geometry"/></mxCell>
        <object label="Zoom out: the open mesh" link="data:page/id,mesh-1" id="c1002"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1a73e8;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="260" height="34" as="geometry"/></mxCell></object>
        <mxCell id="c1003" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=2;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="900" height="380" as="geometry"/></mxCell>
        <mxCell id="c1004" value="1  SAME PLACE: two households in one county link directly" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="118" width="800" height="22" as="geometry"/></mxCell>
        <mxCell id="c1005" value="&lt;b&gt;mecklenburg&lt;/b&gt;.nc.usa.earth&lt;br&gt;community box: helps them find each other. It does not carry their data." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="330" y="150" width="320" height="56" as="geometry"/></mxCell>
        <mxCell id="c1006" value="&lt;b&gt;JDSileo&lt;/b&gt;.mecklenburg.nc.usa.earth&lt;br&gt;HOUSEHOLD box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="250" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="c1007" value="" style="shape=mxgraph.networks.server;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;align=center;verticalAlign=middle;verticalLabelPosition=bottom;fillColor=#505050;strokeColor=#222222;" vertex="1" parent="1"><mxGeometry x="336" y="256" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="c1008" value="&lt;b&gt;Rivera&lt;/b&gt;.mecklenburg.nc.usa.earth&lt;br&gt;HOUSEHOLD box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="250" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="c1009" value="" style="shape=mxgraph.networks.server;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;align=center;verticalAlign=middle;verticalLabelPosition=bottom;fillColor=#505050;strokeColor=#222222;" vertex="1" parent="1"><mxGeometry x="836" y="256" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="c1010" value="address lookup only" style="endArrow=classic;html=1;rounded=0;strokeColor=#999999;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;dashPattern=1 3;" edge="1" parent="1" source="c1006" target="c1005"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1011" value="address lookup only" style="endArrow=classic;html=1;rounded=0;strokeColor=#999999;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;dashPattern=1 3;" edge="1" parent="1" source="c1008" target="c1005"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1012" value="DIRECT LINK: one hop" style="endArrow=classic;html=1;rounded=0;strokeColor=#1D8A47;strokeWidth=3;fontSize=10;labelBackgroundColor=#ffffff;startArrow=classic;" edge="1" parent="1" source="c1006" target="c1008"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1013" value="" style="shape=mxgraph.networks.mobile;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=top;verticalLabelPosition=bottom;labelPosition=center;fillColor=#505050;strokeColor=#222222;" vertex="1" parent="1"><mxGeometry x="196.0" y="375" width="36" height="56" as="geometry"/></mxCell>
        <mxCell id="c1014" value="&lt;b&gt;Joseph&lt;/b&gt; · phone&lt;br&gt;Joseph@​JDSileo.​mecklenburg.​nc.​usa.​earth" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=9;align=center;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="150" y="437" width="128" height="70" as="geometry"/></mxCell>
        <mxCell id="c1015" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#d6b656;strokeWidth=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;dashPattern=1 3;" edge="1" parent="1" source="c1013" target="c1006"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1016" value="" style="shape=mxgraph.networks.tablet;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=top;verticalLabelPosition=bottom;labelPosition=center;fillColor=#505050;strokeColor=#222222;" vertex="1" parent="1"><mxGeometry x="690.0" y="375" width="48" height="56" as="geometry"/></mxCell>
        <mxCell id="c1017" value="&lt;b&gt;Ana&lt;/b&gt; · tablet&lt;br&gt;Ana@​Rivera.​mecklenburg.​nc.​usa.​earth" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=9;align=center;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="650" y="437" width="128" height="70" as="geometry"/></mxCell>
        <mxCell id="c1018" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#d6b656;strokeWidth=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;dashPattern=1 3;" edge="1" parent="1" source="c1016" target="c1008"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1019" value="On the same network the data never leaves the building." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=10;align=center;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="330" y="440" width="320" height="36" as="geometry"/></mxCell>
        <mxCell id="c1020" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=2;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="900" height="450" as="geometry"/></mxCell>
        <mxCell id="c1021" value="2  FAR APART: the same peer circle across places and boxes" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="528" width="800" height="22" as="geometry"/></mxCell>
        <mxCell id="c1022" value="community tree (earth, usa, pl)&lt;br&gt;finds addresses, relays ciphertext when needed, holds replicas members offer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="270" y="560" width="400" height="56" as="geometry"/></mxCell>
        <mxCell id="c1023" value="&lt;b&gt;JDSileo&lt;/b&gt;.mecklenburg.nc.usa.earth&lt;br&gt;HOUSEHOLD box, North Carolina" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="660" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="c1024" value="" style="shape=mxgraph.networks.server;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;align=center;verticalAlign=middle;verticalLabelPosition=bottom;fillColor=#505050;strokeColor=#222222;" vertex="1" parent="1"><mxGeometry x="336" y="666" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="c1025" value="&lt;b&gt;Nowak&lt;/b&gt;.odygowice.pl.earth&lt;br&gt;HOUSEHOLD box, Poland" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="660" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="c1026" value="" style="shape=mxgraph.networks.server;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;align=center;verticalAlign=middle;verticalLabelPosition=bottom;fillColor=#505050;strokeColor=#222222;" vertex="1" parent="1"><mxGeometry x="836" y="666" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="c1027" value="&lt;b&gt;acme&lt;/b&gt;.mecklenburg.nc.usa.earth&lt;br&gt;ORGANIZATION box, North Carolina" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="840" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="c1028" value="" style="shape=mxgraph.networks.server;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;align=center;verticalAlign=middle;verticalLabelPosition=bottom;fillColor=#505050;strokeColor=#222222;" vertex="1" parent="1"><mxGeometry x="586" y="846" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="c1029" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#999999;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;dashPattern=1 3;" edge="1" parent="1" source="c1023" target="c1022"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1030" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#999999;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;dashPattern=1 3;" edge="1" parent="1" source="c1025" target="c1022"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1031" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#999999;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;dashPattern=1 3;" edge="1" parent="1" source="c1027" target="c1022"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1032" value="lookup only" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=9;align=center;verticalAlign=top;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="440" y="622" width="100" height="18" as="geometry"/></mxCell>
        <mxCell id="c1033" value="direct link over the internet" style="endArrow=classic;html=1;rounded=0;strokeColor=#1D8A47;strokeWidth=3;fontSize=10;labelBackgroundColor=#ffffff;startArrow=classic;" edge="1" parent="1" source="c1023" target="c1025"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1034" value="direct" style="endArrow=classic;html=1;rounded=0;strokeColor=#1D8A47;strokeWidth=3;fontSize=10;labelBackgroundColor=#ffffff;startArrow=classic;" edge="1" parent="1" source="c1023" target="c1027"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1035" value="direct" style="endArrow=classic;html=1;rounded=0;strokeColor=#1D8A47;strokeWidth=3;fontSize=10;labelBackgroundColor=#ffffff;startArrow=classic;" edge="1" parent="1" source="c1025" target="c1027"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1036" value="The circle is its own community. The three boxes stay in their physical communities for civic tools and public data." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=10;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="940" width="860" height="20" as="geometry"/></mxCell>
        <mxCell id="c1037" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=2;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="980" y="110" width="880" height="300" as="geometry"/></mxCell>
        <mxCell id="c1038" value="THE SHORTEST PATH, IN ORDER (the client tries the first that works)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1000" y="118" width="840" height="22" as="geometry"/></mxCell>
        <mxCell id="c1039" value="1  Same network (home, office, campus): the data never leaves the building." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1000" y="150" width="840" height="54" as="geometry"/></mxCell>
        <mxCell id="c1040" value="2  Direct over the internet: box to box, encrypted, no third party in between." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1000" y="212" width="840" height="54" as="geometry"/></mxCell>
        <mxCell id="c1041" value="3  Through a community relay: used when both boxes sit behind routers. The relay moves ciphertext it cannot read. Open decision: dns-home-node-reach." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1000" y="274" width="840" height="54" as="geometry"/></mxCell>
        <mxCell id="c1042" value="4  Through the community tree: last resort, and the way to find an address." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1000" y="336" width="840" height="54" as="geometry"/></mxCell>
        <mxCell id="c1043" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=2;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="980" y="430" width="880" height="270" as="geometry"/></mxCell>
        <mxCell id="c1044" value="WHAT A PEER LINK CARRIES" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1000" y="438" width="840" height="22" as="geometry"/></mxCell>
        <mxCell id="c1045" value="Users" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1000" y="470" width="190" height="40" as="geometry"/></mxCell>
        <mxCell id="c1046" value="each box shares the roster entries it chooses: names and roles, never passwords. A person keeps one identity and their own box." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1190" y="470" width="650" height="40" as="geometry"/></mxCell>
        <mxCell id="c1047" value="Chat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1000" y="514" width="190" height="40" as="geometry"/></mxCell>
        <mxCell id="c1048" value="Matrix between the boxes. Rooms live on the boxes of their members." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1190" y="514" width="650" height="40" as="geometry"/></mxCell>
        <mxCell id="c1049" value="Calls" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1000" y="558" width="190" height="40" as="geometry"/></mxCell>
        <mxCell id="c1050" value="one member box runs the call server. The other members connect to it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1190" y="558" width="650" height="40" as="geometry"/></mxCell>
        <mxCell id="c1051" value="Calendar, tasks, files" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1000" y="602" width="190" height="40" as="geometry"/></mxCell>
        <mxCell id="c1052" value="shared spaces copied only to the member boxes, encrypted on the wire." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1190" y="602" width="650" height="40" as="geometry"/></mxCell>
        <mxCell id="c1053" value="Mail and phone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1000" y="646" width="190" height="40" as="geometry"/></mxCell>
        <mxCell id="c1054" value="the same address text still works: User@Org.LocalityChain." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1190" y="646" width="650" height="40" as="geometry"/></mxCell>
        <mxCell id="c1055" value="A LINK IS A PAIR OF SIGNED GRANTS in the consent ledger (page 9). Either side ends it. The link names what is shared, with whom, and until when." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="980" y="720" width="880" height="56" as="geometry"/></mxCell>
        <mxCell id="c1056" value="WHY IT MATTERS&lt;br&gt;Privacy: no platform sits between members. Data lives on the boxes of the people in the circle, and nowhere else unless an owner chooses a copy.&lt;br&gt;No subscription: no per-seat fee and no platform account. Costs that remain are the hardware, power, an internet connection, an optional domain name, and carrier fees for outside phone numbers.&lt;br&gt;Resilience: the circle keeps working if a community box or a company goes away." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="980" y="790" width="880" height="150" as="geometry"/></mxCell>
        <mxCell id="c1057" value="Built today: node keys and signed peer requests, a certificate broker, a Headscale tailnet test, Matrix and LiveKit for talk. Not built: circles, roster sync, path choice, the relay." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=10;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="980" y="950" width="880" height="36" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="8 Who sees what" id="mesh-4">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="2200" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1001" value="A chart anyone can read: who sees what. Everything outside &quot;Me&quot; starts at None. You raise it per item and per audience, and you can lower it again. PROPOSED design." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=14;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="20" width="1600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c1002" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="40" y="120" width="720" height="720" as="geometry" />
        </mxCell>
        <mxCell id="c1003" value="OPEN MESH and the public: only what you publish" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=top;fontColor=#333333;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="250" y="130" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="c1004" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="100" y="180" width="600" height="600" as="geometry" />
        </mxCell>
        <mxCell id="c1005" value="COMMUNITY: what you share into it" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=top;fontColor=#333333;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="250" y="190" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="c1006" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="160" y="240" width="480" height="480" as="geometry" />
        </mxCell>
        <mxCell id="c1007" value="ORGANIZATION: what you share with it" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=top;fontColor=#333333;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="250" y="250" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="c1008" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="220" y="300" width="360" height="360" as="geometry" />
        </mxCell>
        <mxCell id="c1009" value="HOUSEHOLD: what you share at home" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=top;fontColor=#333333;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="250" y="310" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="c1010" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="290" y="370" width="220" height="220" as="geometry" />
        </mxCell>
        <mxCell id="c1011" value="ME: everything, always" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=top;fontColor=#333333;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="250" y="420" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="c1012" value="Encrypted copies on peers you choose sit outside every ring: the host can store them and cannot read them." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=10;align=left;verticalAlign=top;fontColor=#333333;" parent="1" vertex="1">
          <mxGeometry x="60" y="850" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c1013" value="Data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="840" y="100" width="190" height="44" as="geometry" />
        </mxCell>
        <mxCell id="c1014" value="Me" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="1030" y="100" width="110" height="44" as="geometry" />
        </mxCell>
        <mxCell id="c1015" value="Household" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="1140" y="100" width="110" height="44" as="geometry" />
