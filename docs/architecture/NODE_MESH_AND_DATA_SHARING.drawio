        <mxCell id="c1001" value="Every box joins a household, an organization or a community, in a real place or a custom layout. The community tree is also the DNS tree. Names are samples. Click a box for the inside view." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=14;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" parent="1" vertex="1">
