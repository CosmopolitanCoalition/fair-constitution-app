          <mxGeometry x="880" y="610" width="780" height="280" as="geometry" />
        </mxCell>
        <mxCell id="c1074" value="You" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="1080" y="650" width="100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c1075" value="Family box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="900" y="740" width="130" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c1076" value="Acme Co-op" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1230" y="740" width="130" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c1077" value="NYC community" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1450" y="740" width="150" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c1078" value="Backup box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1450" y="650" width="130" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c1079" value="shares calendar in full" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;startArrow=classic;" parent="1" source="c1074" target="c1075" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c1080" value="shares free and busy only" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;startArrow=classic;" parent="1" source="c1074" target="c1076" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c1081" value="shares its public roster" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;startArrow=classic;" parent="1" source="c1076" target="c1077" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c1082" value="it holds my encrypted backup" style="endArrow=classic;html=1;rounded=0;strokeColor=#4a7fb5;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;startArrow=classic;dashed=1;" parent="1" source="c1074" target="c1078" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c1083" value="Click any line to see the grant behind it, and to end it." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=10;align=left;verticalAlign=top;fontColor=#333333;" parent="1" vertex="1">
          <mxGeometry x="890" y="800" width="700" height="20" as="geometry" />
        </mxCell>
        <mxCell id="c1084" value="Every sentence here is generated from the consent ledger. If a sentence is not on this screen, it is not happening." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=10;align=left;verticalAlign=top;fontColor=#333333;" parent="1" vertex="1">
          <mxGeometry x="60" y="880" width="1500" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="11 Off-network profile links" id="mesh-9">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1300" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="c1001" value="Profiles can carry links to anything outside the mesh. A link is shared with one contact or published to an audience. The owner chooses each one. The node stores the link, not the password. PROPOSED design." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=14;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2000" height="30" as="geometry"/></mxCell>
        <object label="Zoom out: the open mesh" link="data:page/id,mesh-1" id="c1002"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1a73e8;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="260" height="34" as="geometry"/></mxCell></object>
        <mxCell id="c1003" value="WHAT CAN BE LINKED (examples, not a closed list)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1000" height="22" as="geometry"/></mxCell>
        <mxCell id="c1004" value="&lt;b&gt;Messaging apps&lt;/b&gt;&lt;br&gt;WhatsApp, Signal, Telegram, iMessage, Facebook Messenger, WeChat, LINE, Viber, Threema, KakaoTalk, Discord, Slack, Microsoft Teams, SMS number, Matrix on other servers, XMPP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="340" height="156" as="geometry"/></mxCell>
        <mxCell id="c1005" value="&lt;b&gt;Social networks&lt;/b&gt;&lt;br&gt;Facebook, Instagram, X, Threads, Bluesky, Mastodon and the fediverse, TikTok, Snapchat, Reddit, Pinterest, Tumblr, VK, Weibo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="400" y="140" width="340" height="156" as="geometry"/></mxCell>
        <mxCell id="c1006" value="&lt;b&gt;Professional and developer&lt;/b&gt;&lt;br&gt;LinkedIn, Xing, GitHub, GitLab, Behance, Dribbble, ORCID, a company directory page, a conference speaker page" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="760" y="140" width="340" height="156" as="geometry"/></mxCell>
        <mxCell id="c1007" value="&lt;b&gt;Video, audio and streams&lt;/b&gt;&lt;br&gt;YouTube, Twitch, Vimeo, Spotify, Apple Podcasts, SoundCloud, Bandcamp, podcast and RSS feeds, a personal RTMP stream" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="340" height="156" as="geometry"/></mxCell>
        <mxCell id="c1008" value="&lt;b&gt;Meetings and scheduling&lt;/b&gt;&lt;br&gt;Zoom, Google Meet, Microsoft Teams, Jitsi, Calendly, a booking page, a public calendar feed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="400" y="310" width="340" height="156" as="geometry"/></mxCell>
        <mxCell id="c1009" value="&lt;b&gt;Phone and mail&lt;/b&gt;&lt;br&gt;a public phone line, a mobile number, a main office number, other email addresses, a mailing address" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="760" y="310" width="340" height="156" as="geometry"/></mxCell>
        <mxCell id="c1010" value="&lt;b&gt;Web and documents&lt;/b&gt;&lt;br&gt;a personal site, a blog, a wiki, a link page, a shared drive folder, a map listing for a business" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="340" height="156" as="geometry"/></mxCell>
        <mxCell id="c1011" value="&lt;b&gt;Support and payment pages&lt;/b&gt;&lt;br&gt;a donation page, Patreon, Ko-fi, PayPal.me, Cash App, a shop page, an invoice portal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="400" y="480" width="340" height="156" as="geometry"/></mxCell>
        <mxCell id="c1012" value="&lt;b&gt;Organizations and events&lt;/b&gt;&lt;br&gt;a charity or company registry entry, Meetup, Eventbrite, a school or club page, a government service page" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="760" y="480" width="340" height="156" as="geometry"/></mxCell>
        <mxCell id="c1013" value="&lt;b&gt;Identity proofs and keys&lt;/b&gt;&lt;br&gt;a PGP key, a passkey, a decentralized identifier, a signed statement, a verified domain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="340" height="156" as="geometry"/></mxCell>
        <mxCell id="c1014" value="&lt;b&gt;Another node&lt;/b&gt;&lt;br&gt;a profile on a different mesh or a different TLD alias of this one" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="400" y="650" width="340" height="156" as="geometry"/></mxCell>
        <mxCell id="c1015" value="&lt;b&gt;Anything else&lt;/b&gt;&lt;br&gt;any web address or handle the owner can paste. The node treats it as text and a link." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="760" y="650" width="340" height="156" as="geometry"/></mxCell>
        <mxCell id="c1016" value="A LINK RECORD (one per outside account or page)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1150" y="110" width="910" height="22" as="geometry"/></mxCell>
        <mxCell id="c1017" value="Kind" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1150" y="140" width="200" height="36" as="geometry"/></mxCell>
        <mxCell id="c1018" value="WhatsApp, Mastodon, a phone line, any web address" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1350" y="140" width="710" height="36" as="geometry"/></mxCell>
        <mxCell id="c1019" value="Handle or address" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1150" y="176" width="200" height="36" as="geometry"/></mxCell>
        <mxCell id="c1020" value="a username, a phone number or a URL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1350" y="176" width="710" height="36" as="geometry"/></mxCell>
        <mxCell id="c1021" value="Profile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1150" y="212" width="200" height="36" as="geometry"/></mxCell>
        <mxCell id="c1022" value="personal, household or organization, or community" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1350" y="212" width="710" height="36" as="geometry"/></mxCell>
        <mxCell id="c1023" value="Audience" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1150" y="248" width="200" height="36" as="geometry"/></mxCell>
        <mxCell id="c1024" value="public, community, organization, household, one contact, or only me (page 8)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1350" y="248" width="710" height="36" as="geometry"/></mxCell>
        <mxCell id="c1025" value="Proof" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1150" y="284" width="200" height="36" as="geometry"/></mxCell>
        <mxCell id="c1026" value="claimed, or proven by one of the checks below" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1350" y="284" width="710" height="36" as="geometry"/></mxCell>
        <mxCell id="c1027" value="Dates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1150" y="320" width="200" height="36" as="geometry"/></mxCell>
        <mxCell id="c1028" value="added, last checked, optional end date" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1350" y="320" width="710" height="36" as="geometry"/></mxCell>
        <mxCell id="c1029" value="A  SHARE BETWEEN TWO PEOPLE" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1150" y="376" width="910" height="22" as="geometry"/></mxCell>
        <mxCell id="c1030" value="Your node&lt;br&gt;pick which links to give this contact" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1150" y="406" width="200" height="74" as="geometry"/></mxCell>
        <mxCell id="c1031" value="Consent&lt;br&gt;only this contact, optional end date" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1387" y="406" width="200" height="74" as="geometry"/></mxCell>
        <mxCell id="c1032" value="Their node&lt;br&gt;shows the links on the contact card and saves them in the CRM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1624" y="406" width="200" height="74" as="geometry"/></mxCell>
        <mxCell id="c1033" value="Either side removes it&lt;br&gt;the node stops serving and showing it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1861" y="406" width="200" height="74" as="geometry"/></mxCell>
        <mxCell id="c1034" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c1030" target="c1031"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1035" value="signed grant" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c1031" target="c1032"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1036" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c1032" target="c1033"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1037" value="Before step 1 the two nodes compare only the kinds of network each side will disclose (page 6). Handles move after both approve." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=10;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1150" y="486" width="910" height="34" as="geometry"/></mxCell>
        <mxCell id="c1038" value="B  PUBLISH TO A PROFILE" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1150" y="536" width="910" height="22" as="geometry"/></mxCell>
        <mxCell id="c1039" value="Link record&lt;br&gt;with its audience" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1150" y="566" width="200" height="74" as="geometry"/></mxCell>
        <mxCell id="c1040" value="Profile card&lt;br&gt;checks who is asking: public, community, organization, household, contact" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1387" y="566" width="200" height="74" as="geometry"/></mxCell>
        <mxCell id="c1041" value="HTTPS page and WebFinger&lt;br&gt;show only the links that match the reader" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1624" y="566" width="200" height="74" as="geometry"/></mxCell>
        <mxCell id="c1042" value="Readers&lt;br&gt;other nodes, outside apps, people on the web" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1861" y="566" width="200" height="74" as="geometry"/></mxCell>
        <mxCell id="c1043" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c1039" target="c1040"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1044" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c1040" target="c1041"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1045" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c1041" target="c1042"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1046" value="HOW A LINK IS PROVEN (shown as claimed until one passes)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1150" y="666" width="910" height="22" as="geometry"/></mxCell>
        <mxCell id="c1047" value="Back-link: the outside profile links back to this name, so the owner controls both" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1150" y="696" width="910" height="42" as="geometry"/></mxCell>
        <mxCell id="c1048" value="Challenge code: the node gives a code, the owner posts it or messages it from that account, the node reads it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1150" y="744" width="910" height="42" as="geometry"/></mxCell>
        <mxCell id="c1049" value="Account sign-in: the owner approves the outside service. The token stays in the owner's vault. Only for services with such a sign-in" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1150" y="792" width="910" height="42" as="geometry"/></mxCell>
        <mxCell id="c1050" value="RULES&lt;br&gt;A link is text and a pointer. It gives no access to the outside account.&lt;br&gt;Links tied to a phone number (WhatsApp, Signal, Telegram, SMS) default to one contact or only me, never public.&lt;br&gt;Removing a link stops this node from serving it. It cannot take back what a reader already saw.&lt;br&gt;An organization or community can publish public lines, such as a main phone or a help desk, as its own links." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1150" y="850" width="910" height="120" as="geometry"/></mxCell>
        <mxCell id="c1051" value="IMPORT&lt;br&gt;The owner can pull links from an export file or an approved account, and reviews each one before it is saved. Nothing is published on import." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="1060" height="66" as="geometry"/></mxCell>
        <mxCell id="c1052" value="Built today: the owner's vault, scoped keys, the CRM contact card. Not built: link records, audiences per link, proofs, profile cards, WebFinger, contact exchange." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=10;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="915" width="1060" height="30" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="12 Nodes one person may belong to" id="node-paradigm-2">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1001" value="A high-level view of how nodes connect, with an example of the nodes one person may belong to. Scaling up: many instances, one data-sharing and permission system. A name in the DNS tree maps to a place on the jurisdiction map. Name SHAPES below are SAMPLES: decisions dns-name-shape, dns-foreign-domain-keys and dns-home-node-reach are open in the rubric." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=13;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="20" width="1500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c1002" value="SAMPLE DNS tree (option A, delegated subzones, the desk recommendation). Each community node runs its own zone." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="80" width="800" height="20" as="geometry" />
        </mxCell>
        <mxCell id="c1003" value="worldofstatecraft.org&lt;br&gt;root  ·  Earth community node" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="360" y="110" width="260" height="52" as="geometry" />
        </mxCell>
        <mxCell id="c1004" value="us.worldofstatecraft.org&lt;br&gt;United States community node" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="120" y="210" width="260" height="52" as="geometry" />
        </mxCell>
        <mxCell id="c1005" value="pl.worldofstatecraft.org&lt;br&gt;Poland community node" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="560" y="210" width="260" height="52" as="geometry" />
        </mxCell>
        <mxCell id="c1006" value="ny.us.worldofstatecraft.org&lt;br&gt;New York community node" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="120" y="310" width="260" height="52" as="geometry" />
        </mxCell>
        <mxCell id="c1007" value="nyc.ny.us.worldofstatecraft.org&lt;br&gt;New York City community node" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="120" y="410" width="260" height="52" as="geometry" />
        </mxCell>
        <mxCell id="c1008" value="odygowice.pl.worldofstatecraft.org&lt;br&gt;Gmina Odygowice community node" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="560" y="310" width="260" height="52" as="geometry" />
        </mxCell>
        <mxCell id="c1009" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" parent="1" source="c1003" target="c1004" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c1010" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" parent="1" source="c1003" target="c1005" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c1011" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" parent="1" source="c1004" target="c1006" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c1012" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" parent="1" source="c1006" target="c1007" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c1013" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" parent="1" source="c1005" target="c1008" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c1014" value="A domain holder can offer its own domain to chosen nodes:&lt;br&gt;ourtown.example   (CNAME on _acme-challenge hands over only the certificate right; delete it to revoke)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="560" y="410" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c1015" value="Stable key = the jurisdiction slug, never its position. A rename or boundary change moves an alias, not the node." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=10;align=left;verticalAlign=top;fontColor=#333333;" parent="1" vertex="1">
          <mxGeometry x="40" y="480" width="860" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c1016" value="SAMPLE node addresses by type, inside the community zone nyc.ny.us.worldofstatecraft.org" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="520" width="860" height="20" as="geometry" />
        </mxCell>
        <mxCell id="c1017" value="Community node&lt;br&gt;nyc.ny.us.worldofstatecraft.org" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="40" y="550" width="270" height="52" as="geometry" />
        </mxCell>
        <mxCell id="c1018" value="Organization node&lt;br&gt;acme-coop.org.nyc.ny.us.worldofstatecraft.org" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="320" y="550" width="290" height="52" as="geometry" />
        </mxCell>
        <mxCell id="c1019" value="Household node&lt;br&gt;smiths.hh.nyc.ny.us.worldofstatecraft.org" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="620" y="550" width="280" height="52" as="geometry" />
        </mxCell>
        <mxCell id="c1020" value="Individual node, on a community name&lt;br&gt;joseph@nyc.ny.us.worldofstatecraft.org  (email compatible)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="40" y="612" width="430" height="52" as="geometry" />
        </mxCell>
        <mxCell id="c1021" value="Individual node, on your own domain&lt;br&gt;jd@jdsileo.com  (the same person, another address)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="480" y="612" width="420" height="52" as="geometry" />
        </mxCell>
        <mxCell id="c1022" value="The type is a role, not a machine. One box can answer for several of these names at once." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=10;align=left;verticalAlign=top;fontColor=#333333;" parent="1" vertex="1">
          <mxGeometry x="40" y="672" width="860" height="20" as="geometry" />
        </mxCell>
        <mxCell id="c1023" value="Instances (boxes) and what each hosts" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="960" y="80" width="640" height="20" as="geometry" />
        </mxCell>
        <mxCell id="c1024" value="Box A  ·  home server&lt;br&gt;Individual (Joseph) + Household (smiths)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="960" y="110" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c1025" value="Box B  ·  community server, NYC&lt;br&gt;Community (nyc) + 3 Organizations + 400 Individuals" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1290" y="110" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c1026" value="Relay&lt;br&gt;a community node relays families behind home routers (open decision, option B)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1125" y="225" width="330" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c1027" value="Box C  ·  Raspberry Pi, Poland&lt;br&gt;Individual (one person)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="960" y="330" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c1028" value="Box D  ·  organization VPS&lt;br&gt;Organization (acme-coop)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1290" y="330" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c1029" value="family data a member consents to share" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;startArrow=classic;" parent="1" source="c1024" target="c1025" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c1030" value="member roster, shared records" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;startArrow=classic;" parent="1" source="c1025" target="c1028" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c1031" value="chosen backup copy" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;startArrow=classic;dashed=1;" parent="1" source="c1024" target="c1027" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c1032" value="read-only copy of place data" style="endArrow=classic;html=1;rounded=0;strokeColor=#d79b00;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;startArrow=classic;dashed=1;" parent="1" source="c1027" target="c1026" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c1033" value="via the community relay" style="endArrow=classic;html=1;rounded=0;strokeColor=#d79b00;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;startArrow=classic;dashed=1;" parent="1" source="c1026" target="c1025" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c1034" value="Rules of the mesh&lt;br&gt;- A person chooses which boxes hold their data.&lt;br&gt;- Shared assets and joint organizations may live on several boxes.&lt;br&gt;- Nothing syncs without consent, and every request is signed by the sending node.&lt;br&gt;- A box that is not physically in a place may hold that place read-only.&lt;br&gt;- Hosting a domain carries the community&#39;s agreement to that DNS entry." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="960" y="430" width="630" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c1035" value="Ways in, on every box:&lt;br&gt;phone, desktop, laptop, TV (installed web app or native app) · smart speaker · voice satellite (Jarvis) · tools by API key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="960" y="600" width="630" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="13 Onboarding flow" id="onboard-1">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1300" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="c1001" value="Onboarding a node operator: choose what the box hosts, where it lives, who is on it, which tools to bundle, and which AI assistants help. The running demo box gets these as screens in the operator area. A fresh-node front door comes later. PROPOSED design." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=14;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2000" height="40" as="geometry"/></mxCell>
        <object label="Next: bundled tools and AI assistants" link="data:page/id,onboard-2" id="c1002"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1a73e8;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="300" height="34" as="geometry"/></mxCell></object>
        <object label="Zoom out: the open mesh" link="data:page/id,mesh-1" id="c1003"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1a73e8;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="360" y="70" width="260" height="34" as="geometry"/></mxCell></object>
        <mxCell id="c1004" value="&lt;b&gt;1  Who is this box for?&lt;/b&gt;&lt;br&gt;Just me, my household, an organization, or a community. Individual is always on. Everyone starts in a household of one. The answer sets the node kits (page 3)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="720" height="128" as="geometry"/></mxCell>
        <mxCell id="c1005" value="&lt;b&gt;2  Where does it live?&lt;/b&gt;&lt;br&gt;A real place on the map, or a custom layout (cosmic address, Multiverse). The name chain follows from it, such as JDSileo.mecklenburg.nc.usa.earth. Choose a mesh to join: adopt one, self-sign, simulate, or none yet." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="720" height="128" as="geometry"/></mxCell>
        <mxCell id="c1006" value="&lt;b&gt;3  How is it reached?&lt;/b&gt;&lt;br&gt;Own router and equipment, a community relay, a cloud tunnel, or LAN only behind your own VPN. Open decision: dns-home-node-reach." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="720" height="128" as="geometry"/></mxCell>
        <mxCell id="c1007" value="&lt;b&gt;4  Who is on it?&lt;/b&gt;&lt;br&gt;Invite each person over a channel you choose and name the relationship (partner, parent, friend, coworker). A household presets who may see what, and names succession triggers." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="720" height="128" as="geometry"/></mxCell>
        <mxCell id="c1008" value="&lt;b&gt;5  What does it offer the mesh?&lt;/b&gt;&lt;br&gt;Storage, compute and hours for others, and which audiences may use them (page 10). Nothing is offered by default." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="730" width="720" height="128" as="geometry"/></mxCell>
        <mxCell id="c1009" value="&lt;b&gt;6  Which tools to bundle?&lt;/b&gt;&lt;br&gt;Pick bundles: home and devices, monitoring, automation, media, files and office, talk, mail and phone. Each shows its memory and disk cost against this box (page 14)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="800" y="130" width="720" height="128" as="geometry"/></mxCell>
        <mxCell id="c1010" value="&lt;b&gt;7  Which AI assistants help?&lt;/b&gt;&lt;br&gt;Pick a brain per task: a local model, a cloud model, or a coding assistant for long jobs. Name the roles they fill, who sponsors each, and what each may do (page 14)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="800" y="280" width="720" height="128" as="geometry"/></mxCell>
        <mxCell id="c1011" value="&lt;b&gt;8  Review the plan&lt;/b&gt;&lt;br&gt;One screen lists the kits, tools, containers, the memory and disk they need, what is shared outward, and who can see it. Change any line, then confirm." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="800" y="430" width="720" height="128" as="geometry"/></mxCell>
        <mxCell id="c1012" value="&lt;b&gt;9  Install and check&lt;/b&gt;&lt;br&gt;Start the containers, run a health check per tool, choose a backup partner, and show a first-run tour. A failed check shows the exact fix and blocks nothing else." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="800" y="580" width="720" height="128" as="geometry"/></mxCell>
        <mxCell id="c1013" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c1004" target="c1005"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1014" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c1005" target="c1006"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1015" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c1006" target="c1007"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1016" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c1007" target="c1008"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1017" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c1009" target="c1010"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1018" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c1010" target="c1011"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1019" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c1011" target="c1012"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1020" value="Steps 6 to 9 continue in the next column." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=10;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="720" height="20" as="geometry"/></mxCell>
        <mxCell id="c1021" value="BOX SIZE PICKS THE DEFAULTS (to be measured, see the roadmap item &quot;Measure the containers each node set needs&quot;)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1540" y="130" width="520" height="40" as="geometry"/></mxCell>
        <mxCell id="c1022" value="&lt;b&gt;Raspberry Pi or small mini PC&lt;/b&gt;&lt;br&gt;Individual and household, talk, a few light tools. No simulation, no large queues." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1540" y="180" width="520" height="100" as="geometry"/></mxCell>
        <mxCell id="c1023" value="&lt;b&gt;Home server (7 GB RAM class, one spinning disk)&lt;/b&gt;&lt;br&gt;Adds bundles one at a time. The review step warns before memory or disk runs short." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1540" y="292" width="520" height="100" as="geometry"/></mxCell>
        <mxCell id="c1024" value="&lt;b&gt;VPS or office server&lt;/b&gt;&lt;br&gt;Adds an organization kit, mail, shared files and media." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1540" y="404" width="520" height="100" as="geometry"/></mxCell>
        <mxCell id="c1025" value="&lt;b&gt;Community machine&lt;/b&gt;&lt;br&gt;Adds the community kit, replicas for members, and a relay if it offers one." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1540" y="516" width="520" height="100" as="geometry"/></mxCell>
        <mxCell id="c1026" value="RULES&lt;br&gt;The operator enters every credential. The wizard prepares the steps and never handles the values.&lt;br&gt;Each choice can be changed later in the operator area. Nothing here is permanent.&lt;br&gt;No account with a vendor is required to finish setup." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1540" y="640" width="520" height="150" as="geometry"/></mxCell>
        <mxCell id="c1027" value="Built today: the setup wizard for the community kit, the operator profile, invites, per-user keys, the vault. Not built: steps 1, 3 to 9 as screens, bundle selection, assistant roles." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=10;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="915" width="1500" height="30" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="14 Bundled tools and AI assistants" id="onboard-2">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1300" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="c1001" value="Native tools come with the app. Bundles add self-hosted tools that are designed to work with it. Pipelines connect them, so one assistant can look after devices and people through the same permissions. PROPOSED design." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=14;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2000" height="40" as="geometry"/></mxCell>
        <object label="Back: onboarding flow" link="data:page/id,onboard-1" id="c1002"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1a73e8;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="260" height="34" as="geometry"/></mxCell></object>
        <object label="Zoom out: the open mesh" link="data:page/id,mesh-1" id="c1003"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1a73e8;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="320" y="70" width="260" height="34" as="geometry"/></mxCell></object>
        <mxCell id="c1004" value="&lt;b&gt;NATIVE, BUILT INTO THE APP&lt;/b&gt;&lt;br&gt;calendar · tasks · contacts and CRM · inbox with approval before any send · messenger and calls (Matrix, LiveKit) · secret vault · scoped API keys · organizations and households · the community engine (elections, legislatures, courts) · public square and rooms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="1040" height="78" as="geometry"/></mxCell>
        <mxCell id="c1005" value="BUNDLES. Green = running in the fleet today (from the executive ledger). Yellow = planned or a candidate, not running. A tool joins the app through a scoped key or an n8n pipeline, never by sharing the owner's password." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="1040" height="40" as="geometry"/></mxCell>
        <mxCell id="c1006" value="&lt;b&gt;Home and devices (IoT)&lt;/b&gt;&lt;br&gt;Home Assistant · Mosquitto (MQTT) · Wyoming voice: openWakeWord, Whisper, Piper" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="262" width="340" height="136" as="geometry"/></mxCell>
        <mxCell id="c1007" value="&lt;b&gt;Monitoring&lt;/b&gt;&lt;br&gt;UniFi network controller (running) · Zabbix with an agent on every box (planned: the old server has been stopped since June) · central syslog (planned)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="390" y="262" width="340" height="136" as="geometry"/></mxCell>
        <mxCell id="c1008" value="&lt;b&gt;Automation hub&lt;/b&gt;&lt;br&gt;n8n: holds outside credentials, runs the pipelines and the tool catalog" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="740" y="262" width="340" height="136" as="geometry"/></mxCell>
        <mxCell id="c1009" value="&lt;b&gt;Media&lt;/b&gt;&lt;br&gt;Kodi · Jellyfin · Deluge (seedbox) · shared MySQL library for Kodi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="340" height="136" as="geometry"/></mxCell>
        <mxCell id="c1010" value="&lt;b&gt;AI brains&lt;/b&gt;&lt;br&gt;Ollama (local gateway or cloud models) · a coding assistant for long jobs · any OpenAI-compatible endpoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="390" y="410" width="340" height="136" as="geometry"/></mxCell>
        <mxCell id="c1011" value="&lt;b&gt;Voice and screens&lt;/b&gt;&lt;br&gt;a standalone assistant app on the TV · softphone · voice satellites · screen routing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="740" y="410" width="340" height="136" as="geometry"/></mxCell>
        <mxCell id="c1012" value="&lt;b&gt;Tasks, calendar, mail (replace Office)&lt;/b&gt;&lt;br&gt;Vikunja · Radicale · Stalwart (mail, CalDAV, CardDAV) where the native tools are not enough" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="558" width="340" height="136" as="geometry"/></mxCell>
        <mxCell id="c1013" value="&lt;b&gt;Files and office&lt;/b&gt;&lt;br&gt;Nextcloud with Collabora or OnlyOffice · plain LibreOffice on desktops" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="390" y="558" width="340" height="136" as="geometry"/></mxCell>
        <mxCell id="c1014" value="&lt;b&gt;Notifications and chat&lt;/b&gt;&lt;br&gt;ntfy for phone alerts · Mattermost, Element or Zulip if a team wants more than Matrix rooms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="740" y="558" width="340" height="136" as="geometry"/></mxCell>
        <mxCell id="c1015" value="Each bundle shows its container list, memory and disk cost, ports, and which native tool it connects to. A bundle can be added or removed after onboarding. Removing one never deletes native data." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="712" width="1040" height="50" as="geometry"/></mxCell>
        <mxCell id="c1016" value="&lt;b&gt;OUTSIDE SERVICES&lt;/b&gt; the assistants may reach through n8n: Alexa phrases, Twilio, Telegram, WhatsApp Business, Microsoft and Google accounts, a carrier line. Credentials stay in the owner's vault." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontSize=10;align=left;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="772" width="1040" height="62" as="geometry"/></mxCell>
        <mxCell id="c1017" value="PIPELINES: PEOPLE AND THINGS THROUGH ONE LAYER" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1130" y="120" width="930" height="22" as="geometry"/></mxCell>
        <mxCell id="c1018" value="Zabbix&lt;br&gt;alert: disk 90 percent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1130" y="160" width="190" height="60" as="geometry"/></mxCell>
        <mxCell id="c1019" value="Home Assistant&lt;br&gt;device state, scenes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1130" y="250" width="190" height="60" as="geometry"/></mxCell>
        <mxCell id="c1020" value="Alexa and voice satellites&lt;br&gt;spoken phrases" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontSize=10;align=center;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="1130" y="340" width="190" height="60" as="geometry"/></mxCell>
        <mxCell id="c1021" value="n8n pipelines&lt;br&gt;cheapest path first: rules, then catalog, then a model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1400" y="220" width="250" height="100" as="geometry"/></mxCell>
        <mxCell id="c1022" value="THE APP&lt;br&gt;native tasks, calendar, inbox, CRM, approvals, audit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1750" y="160" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="c1023" value="AI assistant in a role&lt;br&gt;reads, drafts, proposes. Acts only within its key." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1750" y="320" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="c1024" value="webhook" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c1018" target="c1021"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1025" value="events" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c1019" target="c1021"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1026" value="intake" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c1020" target="c1021"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1027" value="scoped key: create task, notify" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;startArrow=classic;" edge="1" parent="1" source="c1021" target="c1022"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1028" value="role, scopes, approvals" style="endArrow=classic;html=1;rounded=0;strokeColor=#d6b656;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;startArrow=classic;" edge="1" parent="1" source="c1022" target="c1023"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1029" value="A-class action after approval" style="endArrow=classic;html=1;rounded=0;strokeColor=#4a7fb5;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c1021" target="c1019"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1030" value="Example: Zabbix reports a full disk. The pipeline opens a task in the household or organization, assigns it to the IT role, and asks the sponsor to approve. On approval, the pipeline starts the clean-up. People tasks and device tasks sit in one list." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=10;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1130" y="420" width="930" height="54" as="geometry"/></mxCell>
        <mxCell id="c1031" value="AI-ASSISTED ROLES (proposed): an assistant is a member with a role, a human sponsor, and a key with named scopes" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1130" y="490" width="930" height="22" as="geometry"/></mxCell>
        <mxCell id="c1032" value="&lt;b&gt;Secretary&lt;/b&gt;&lt;br&gt;sorts the inbox, drafts replies, proposes meeting times. Never sends without approval." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1130" y="520" width="460" height="76" as="geometry"/></mxCell>
        <mxCell id="c1033" value="&lt;b&gt;IT and facilities&lt;/b&gt;&lt;br&gt;watches Zabbix, UniFi and devices, opens tasks, proposes fixes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1600" y="520" width="460" height="76" as="geometry"/></mxCell>
        <mxCell id="c1034" value="&lt;b&gt;Home concierge&lt;/b&gt;&lt;br&gt;answers by voice, runs scenes, routes a page to a screen." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1130" y="604" width="460" height="76" as="geometry"/></mxCell>
        <mxCell id="c1035" value="&lt;b&gt;Researcher&lt;/b&gt;&lt;br&gt;long jobs on a larger model, results come back as a note." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1600" y="604" width="460" height="76" as="geometry"/></mxCell>
        <mxCell id="c1036" value="Safety classes from the executive design: R read only. W reversible write. A needs approval (money, messages sent as a person, deletes, bookings for others). Surface levels: S1 the owner verified, S2 a linked voice assistant, S3 a phone caller. Same tool, different permission." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1130" y="700" width="930" height="70" as="geometry"/></mxCell>
        <mxCell id="c1037" value="OPEN: whether an assistant role appears in the civic role list (R-xx) or only in individual and organization roles. Proposed answer: only the second. An assistant never holds civic office and never votes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1130" y="780" width="930" height="54" as="geometry"/></mxCell>
        <mxCell id="c1038" value="Built today: the vault, scoped keys, the inbox approval rule, the connections screen. In the fleet outside the app: the tools in the green boxes. Not built: bundles as installable options, assistant roles, the pipelines into native tasks." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=10;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="2000" height="30" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
