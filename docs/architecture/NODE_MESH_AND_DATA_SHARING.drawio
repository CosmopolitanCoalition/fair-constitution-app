        <mxCell id="c1018" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;startArrow=classic;" parent="1" source="c1008" target="c1009" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c1019" value="API key, scoped" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;startArrow=classic;" parent="1" source="c1010" target="c1009" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c1020" value="what to show, and where" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" parent="1" source="c1009" target="c1011" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c1021" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#d6b656;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" parent="1" source="c1011" target="c1002" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c1022" value="Built today: installed web app (manifest and service worker), sign-in session, per-user API keys. Prototyped on the second machine: the voice satellite, n8n pipelines, screen routing. Not built: native apps, TV and smart-speaker surfaces." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=10;align=left;verticalAlign=top;fontColor=#333333;" parent="1" vertex="1">
          <mxGeometry x="40" y="680" width="1300" height="40" as="geometry" />
        </mxCell>
