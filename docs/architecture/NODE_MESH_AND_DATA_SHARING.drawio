        <mxCell id="c1067" value="&lt;b&gt;Maria&lt;/b&gt; · phone&lt;br&gt;Maria@​mecklenburg.​nc.​usa.​earth&lt;br&gt;no box of her own: the county box holds her space" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=9;align=center;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="250" y="612" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c1068" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#d6b656;strokeWidth=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;dashPattern=1 3;" edge="1" parent="1" source="c1066" target="c1012">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c1069" value="OFF MESH&lt;br&gt;Other mail servers, phone numbers (a SIP trunk bought from a carrier), other Matrix servers, other services through their APIs. Same address text works: mail and SIP." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontSize=10;align=center;verticalAlign=middle;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1780" y="600" width="330" height="130" as="geometry" />
        </mxCell>
        <mxCell id="c1070" value="mail, SIP, federation" style="endArrow=classic;html=1;rounded=0;strokeColor=#999999;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;startArrow=classic;dashed=1;" edge="1" parent="1" source="c1012" target="c1069">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c1071" value="Lines:  solid = signed sync by consent  ·  dotted yellow = a screen using its box (sign-in session or per-user key over TLS)  ·  dashed = outside the mesh" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=10;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="1080" width="1700" height="20" as="geometry" />
        </mxCell>
        <mxCell id="c1072" value="How a client finds its box: read the address from the right. Planet, country, state, county, then the household or organization. Use the nearest box that offers the datastore. The text before the @ is the person." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="1110" width="820" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c1073" value="Places are a choice. The tree can follow real places or a custom layout. Setup step 0, Multiverse ▸ cosmic address, already lets an operator place a community in virtual space or on the real-world map." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="880" y="1110" width="860" height="60" as="geometry" />
        </mxCell>
        <object label="Address forms, aliases and hosted inboxes: click for page 5" link="data:page/id,mesh-3" id="c1074">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1a73e8;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
            <mxGeometry x="1790" y="740" width="330" height="60" as="geometry" />
          </mxCell>
        </object>
              <object label="Households and organizations as their own community, on the shortest path: click for page 7" link="data:page/id,mesh-7" id="c-link7"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1a73e8;fontSize=11;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1790" y="820" width="330" height="70" as="geometry"/></mxCell></object>
              <object label="Naming and internet protocols, external profiles: click for page 6" link="data:page/id,mesh-8" id="c-link8"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1a73e8;fontSize=11;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1790" y="910" width="330" height="60" as="geometry"/></mxCell></object>
              <object label="Off-network profile links, shared or published: click for page 11" link="data:page/id,mesh-9" id="c-link9"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1a73e8;fontSize=11;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1790" y="990" width="330" height="60" as="geometry"/></mxCell></object>
              <object label="Onboarding flow, bundled tools and AI assistants: click for pages 13 and 14" link="data:page/id,onboard-1" id="c-link13"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1a73e8;fontSize=11;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1790" y="1070" width="330" height="60" as="geometry"/></mxCell></object>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="3 Inside a box" id="mesh-2">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="2200" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1001" value="Zoom in: inside one box. One box hosts any mix of node types, many users, many of each. Every person starts in a household of one." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=14;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="20" width="1500" height="30" as="geometry" />
        </mxCell>
        <object label="Zoom out: the open mesh" link="data:page/id,mesh-1" id="c1002">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1a73e8;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;strokeWidth=2;" parent="1" vertex="1">
            <mxGeometry x="40" y="60" width="260" height="34" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="c1003" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=2;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="40" y="110" width="1040" height="770" as="geometry" />
        </mxCell>
        <mxCell id="c1004" value="ONE BOX  (Raspberry Pi, home server, VPS, community machine)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="60" y="118" width="900" height="22" as="geometry" />
        </mxCell>
        <mxCell id="c1005" value="Node kits this box runs (the operator switches each on and sets its scope)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="60" y="148" width="560" height="20" as="geometry" />
        </mxCell>
        <mxCell id="c1006" value="INDIVIDUAL NODE   default, always on&lt;br&gt;A person&#39;s own space: calendar, tasks, contacts and CRM, inbox, messenger and calls, vault, keys for tools.&lt;br&gt;Every person lives in a HOUSEHOLD OF ONE until others join.&lt;br&gt;Built: yes, since 2026-11-02. Mail server, pipelines, assistant chat: not here yet." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="60" y="172" width="560" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c1007" value="HOUSEHOLD NODE   when people join a household&lt;br&gt;Shared calendar, tasks and files, family templates, who may see what.&lt;br&gt;Built: no." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="60" y="302" width="560" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c1008" value="ORGANIZATION NODE   optional&lt;br&gt;Members, roles, boards, shared records and files.&lt;br&gt;Built: the organizations module. Shared files and CRM: no." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="60" y="397" width="560" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c1009" value="COMMUNITY NODE   optional add-on&lt;br&gt;Either the simulation (World of Statecraft, with demo data and maps) or a real community that hosts its own members.&lt;br&gt;Both can connect to another node and sync." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="60" y="492" width="560" height="105" as="geometry" />
        </mxCell>
        <mxCell id="c1010" value="Scope per type:&lt;br&gt;- who may hold an account here&lt;br&gt;- which places or groups the data covers&lt;br&gt;- what is shared outward and with whom&lt;br&gt;Resources per type: storage and compute offered to the mesh (page 10)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="60" y="607" width="560" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c1011" value="Shared by every kit on the box" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="650" y="148" width="400" height="20" as="geometry" />
        </mxCell>
        <mxCell id="c1012" value="Permission and consent layer&lt;br&gt;owner-only data, per-user keys, scopes, vault, signed grants" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="650" y="172" width="400" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c1013" value="Node identity&lt;br&gt;Ed25519 keys, signed requests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="650" y="282" width="400" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c1014" value="Data and queues&lt;br&gt;Postgres with PostGIS, Redis, job queue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="650" y="352" width="400" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c1015" value="Talk&lt;br&gt;Matrix for text, LiveKit for calls, one window for both" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="650" y="422" width="400" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c1016" value="Mail (proposed)&lt;br&gt;an established mail server on the node&#39;s domain, not written from scratch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="650" y="492" width="400" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c1017" value="Sync and replication&lt;br&gt;what this node shares, and the copies it holds for others" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="650" y="572" width="400" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c1018" value="Containers (from the compose files, grouped by what needs them)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="1110" y="110" width="520" height="20" as="geometry" />
        </mxCell>
        <mxCell id="c1019" value="BASE: nginx, app, postgres, redis, scheduler, horizon (queue worker)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1110" y="140" width="520" height="52" as="geometry" />
        </mxCell>
        <mxCell id="c1020" value="TALK: matrix, mas (sign-in for Matrix), livekit (the &quot;voice&quot; profile)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1110" y="202" width="520" height="52" as="geometry" />
        </mxCell>
        <mxCell id="c1021" value="COMMUNITY SIMULATION: etl (map ingestion, finished here), redis_queue, horizon at its large memory setting" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1110" y="264" width="520" height="66" as="geometry" />
        </mxCell>
        <mxCell id="c1022" value="DEV ONLY: vite (the &quot;dev&quot; profile)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1110" y="340" width="520" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c1023" value="MESH OPTIONS: caddy (public overlay), headscale (tailnet), patroni with etcd and haproxy (data-tier failover)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1110" y="390" width="520" height="66" as="geometry" />
        </mxCell>
        <mxCell id="c1024" value="Which containers each node set truly needs is not measured yet. An Individual-only host likely drops etl and the large horizon, and may share Matrix and LiveKit. Measure on the running demo box before cutting." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1110" y="466" width="520" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c1025" value="A box can run one kit or all of them. The running demo box runs all today." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1110" y="566" width="520" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="4 Ways in" id="node-paradigm-3">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1001" value="Ways in: any screen can drive the same node. Voice and screens use the same permissions as the web app." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=14;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="20" width="1300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c1002" value="Phone&lt;br&gt;installed web app (PWA)&lt;br&gt;native app where possible" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="40" y="80" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c1003" value="Desktop and laptop&lt;br&gt;browser or installed web app" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="40" y="170" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c1004" value="TV&lt;br&gt;browser or app on the TV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="40" y="260" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c1005" value="Smart speaker&lt;br&gt;voice only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="40" y="350" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c1006" value="Another room&lt;br&gt;any screen showing a node page" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="40" y="440" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c1007" value="Voice satellite (Jarvis)&lt;br&gt;wake word, speech to text, command contract:&lt;br&gt;spoken request becomes an intent, the intent asks the node, the node answers with words and a screen to show" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="40" y="540" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c1008" value="Surface layer&lt;br&gt;sign-in session or per-user API key&lt;br&gt;the same permission rules on every surface" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="460" y="250" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c1009" value="Your node&lt;br&gt;Individual · Household · Organization · Community&lt;br&gt;whatever this box hosts for you" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="860" y="230" width="320" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c1010" value="Pipelines and assistants (n8n, Jarvis)&lt;br&gt;act with a scoped key you issue&lt;br&gt;nothing is sent without your approval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="460" y="480" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c1011" value="Screen routing&lt;br&gt;&quot;show the calendar on the bedroom screen&quot;&lt;br&gt;picks the screen, then opens the page there" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="860" y="480" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c1012" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#d6b656;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" parent="1" source="c1002" target="c1008" edge="1">
