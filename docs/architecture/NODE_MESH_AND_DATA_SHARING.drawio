        <mxCell id="c1003" value="THE OPEN MESH: boxes that know each other, share by consent, sign every request. Each community box hosts what its members volunteer." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" parent="1" vertex="1">
