        <mxCell id="c1017" value="Community" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1">
