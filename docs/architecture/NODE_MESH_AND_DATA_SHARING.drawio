        <mxCell id="c1004" value="person, or a group name, optional +subprofile" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=9;align=center;verticalAlign=top;fontColor=#333333;" parent="1" vertex="1">
          <mxGeometry x="60" y="192" width="190" height="50" as="geometry" />
