<mxfile host="app.diagrams.net" version="28.2.4">
  <diagram name="1 Clients and the open mesh" id="mesh-1">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1200" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="c1001" value="Clients connect to their node. Nodes form an open mesh and share only by consent. Names, boxes and numbers are samples. Click a host to zoom in." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=14;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="30" as="geometry"/></mxCell>
        <mxCell id="c1002" value="CLIENTS (any screen)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="280" height="20" as="geometry"/></mxCell>
        <mxCell id="c1003" value="Phone&lt;br&gt;installed web app or native app" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="c1004" value="Laptop and desktop&lt;br&gt;browser or installed web app" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="175" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="c1005" value="TV&lt;br&gt;browser or app on the TV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="c1006" value="Smart speaker&lt;br&gt;voice only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="325" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="c1007" value="Voice satellite (Jupiter)&lt;br&gt;spoken commands drive menus and screens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="280" height="60" as="geometry"/></mxCell>
        <object label="YOUR HOST  ·  Defiant, the dev and demo instance&lt;br&gt;Individual node + a household of one&lt;br&gt;Community node as the simulation add-on (demo data)&lt;br&gt;Click to zoom in: inside a host" link="data:page/id,mesh-2" id="c1008"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="190" width="340" height="130" as="geometry"/></mxCell></object>
        <mxCell id="c1009" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#d6b656;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;dashPattern=1 3;" edge="1" parent="1" source="c1003" target="c1008"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1010" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#d6b656;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;dashPattern=1 3;" edge="1" parent="1" source="c1004" target="c1008"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1011" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#d6b656;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;dashPattern=1 3;" edge="1" parent="1" source="c1005" target="c1008"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1012" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#d6b656;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;dashPattern=1 3;" edge="1" parent="1" source="c1006" target="c1008"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1013" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#d6b656;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;dashPattern=1 3;" edge="1" parent="1" source="c1007" target="c1008"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1014" value="client to server: sign-in session or per-user key, over TLS" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=10;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="330" height="30" as="geometry"/></mxCell>
        <mxCell id="c1015" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f7ff;strokeColor=#4a7fb5;fontSize=12;align=center;verticalAlign=middle;dashed=1;rounded=1;arcSize=3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="800" y="60" width="800" height="800" as="geometry"/></mxCell>
        <mxCell id="c1016" value="THE OPEN MESH: nodes that know each other, share by consent, and sign every request" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="68" width="760" height="24" as="geometry"/></mxCell>
        <mxCell id="c1017" value="Voyager&lt;br&gt;Individual node only&lt;br&gt;Jarvis assistant · holds the backup copy of Defiant" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="830" y="110" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="c1018" value="Family box&lt;br&gt;Household node: three people,&lt;br&gt;each with their own Individual node" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1120" y="110" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="c1019" value="Community node&lt;br&gt;nyc.ny.us&lt;br&gt;residents and a public square" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1370" y="110" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="c1020" value="Relay and certificate broker&lt;br&gt;run by a community, for families behind home routers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="830" y="330" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="c1021" value="Organization node  ·  acme-coop&lt;br&gt;members, roles, shared records and files" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1120" y="330" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="c1022" value="Community node&lt;br&gt;pl.odygowice&lt;br&gt;a second community" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1400" y="330" width="170" height="90" as="geometry"/></mxCell>
        <mxCell id="c1023" value="The organization's clients&lt;br&gt;staff phones, laptops, a TV in the office" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1400" y="460" width="170" height="100" as="geometry"/></mxCell>
        <mxCell id="c1024" value="client to server" style="endArrow=classic;html=1;rounded=0;strokeColor=#d6b656;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;dashPattern=1 3;" edge="1" parent="1" source="c1023" target="c1021"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1025" value="Volunteer storage and compute&lt;br&gt;nodes that offered capacity to the mesh. Any node may place encrypted copies here (pages 4 and 5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="830" y="600" width="740" height="70" as="geometry"/></mxCell>
        <mxCell id="c1026" value="encrypted backup copy" style="endArrow=classic;html=1;rounded=0;strokeColor=#4a7fb5;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;startArrow=classic;dashed=1;" edge="1" parent="1" source="c1008" target="c1017"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1027" value="reach the mesh" style="endArrow=classic;html=1;rounded=0;strokeColor=#d79b00;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;startArrow=classic;dashed=1;dashPattern=1 3;" edge="1" parent="1" source="c1008" target="c1020"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1028" value="sync by consent" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;startArrow=classic;" edge="1" parent="1" source="c1017" target="c1018"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1029" value="shares what members choose" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;startArrow=classic;" edge="1" parent="1" source="c1018" target="c1019"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1030" value="roster, shared records" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;startArrow=classic;" edge="1" parent="1" source="c1019" target="c1021"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1031" value="community to community" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;startArrow=classic;" edge="1" parent="1" source="c1019" target="c1022"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1032" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#d79b00;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;dashPattern=1 3;" edge="1" parent="1" source="c1020" target="c1021"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1033" value="encrypted replicas" style="endArrow=classic;html=1;rounded=0;strokeColor=#4a7fb5;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;startArrow=classic;dashed=1;" edge="1" parent="1" source="c1021" target="c1025"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1034" value="Lines:  solid = signed sync by consent  ·  dashed blue = encrypted replica  ·  dotted = client to server or relay" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=10;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="800" y="700" width="800" height="24" as="geometry"/></mxCell>
        <mxCell id="c1035" value="The operator's own sample&lt;br&gt;Defiant: this running dev instance, kept with its demo data and its maps. Backs up to Voyager.&lt;br&gt;Voyager: Individual node only. Features are built there, ported here, then ported back.&lt;br&gt;A public household node starts from scratch, with no demo data." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="720" height="130" as="geometry"/></mxCell>
        <mxCell id="c1036" value="Built today: node keys and signed requests between nodes, a certificate broker for peers, a Headscale tailnet test, a Patroni data-tier option, the web app with sign-in and keys. Proposed: everything about replication, allotments and the sharing views (pages 3 to 5)." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=10;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="720" height="70" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="2 Inside a host" id="mesh-2">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1200" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="c1001" value="Zoom in: inside one host. One box hosts any mix of node types, many users, many of each. Every person starts in a household of one." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=14;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="30" as="geometry"/></mxCell>
        <object label="Zoom out: the open mesh" link="data:page/id,mesh-1" id="c1002"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1a73e8;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="260" height="34" as="geometry"/></mxCell></object>
        <mxCell id="c1003" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=2;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1040" height="770" as="geometry"/></mxCell>
        <mxCell id="c1004" value="ONE HOST  (Raspberry Pi, home server, VPS, community machine)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="118" width="900" height="22" as="geometry"/></mxCell>
        <mxCell id="c1005" value="Node types this host runs (the operator switches each on and sets its scope)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="148" width="560" height="20" as="geometry"/></mxCell>
        <mxCell id="c1006" value="INDIVIDUAL NODE   default, always on&lt;br&gt;A person's own space: calendar, tasks, contacts and CRM, inbox, messenger and calls, vault, keys for tools.&lt;br&gt;Every person lives in a HOUSEHOLD OF ONE until others join.&lt;br&gt;Built: yes, since 2026-11-02. Mail server, pipelines, assistant chat: not here yet." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="172" width="560" height="120" as="geometry"/></mxCell>
        <mxCell id="c1007" value="HOUSEHOLD NODE   when people join a household&lt;br&gt;Shared calendar, tasks and files, family templates, who may see what.&lt;br&gt;Built: no." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="302" width="560" height="85" as="geometry"/></mxCell>
        <mxCell id="c1008" value="ORGANIZATION NODE   optional&lt;br&gt;Members, roles, boards, shared records and files.&lt;br&gt;Built: the organizations module. Shared files and CRM: no." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="397" width="560" height="85" as="geometry"/></mxCell>
        <mxCell id="c1009" value="COMMUNITY NODE   optional add-on&lt;br&gt;Either the simulation (World of Statecraft, on Defiant, with demo data and maps) or a real community that hosts its own members.&lt;br&gt;Both can connect to another node and sync." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="492" width="560" height="105" as="geometry"/></mxCell>
        <mxCell id="c1010" value="Scope per type:&lt;br&gt;- who may hold an account here&lt;br&gt;- which places or groups the data covers&lt;br&gt;- what is shared outward and with whom&lt;br&gt;Resources per type: storage and compute offered to the mesh (page 5)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="607" width="560" height="110" as="geometry"/></mxCell>
        <mxCell id="c1011" value="Shared by every type on the host" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="650" y="148" width="400" height="20" as="geometry"/></mxCell>
        <mxCell id="c1012" value="Permission and consent layer&lt;br&gt;owner-only data, per-user keys, scopes, vault, signed grants" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="650" y="172" width="400" height="100" as="geometry"/></mxCell>
        <mxCell id="c1013" value="Node identity&lt;br&gt;Ed25519 keys, signed requests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="650" y="282" width="400" height="60" as="geometry"/></mxCell>
        <mxCell id="c1014" value="Data and queues&lt;br&gt;Postgres with PostGIS, Redis, job queue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="650" y="352" width="400" height="60" as="geometry"/></mxCell>
        <mxCell id="c1015" value="Talk&lt;br&gt;Matrix for text, LiveKit for calls, one window for both" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="650" y="422" width="400" height="60" as="geometry"/></mxCell>
        <mxCell id="c1016" value="Mail (proposed)&lt;br&gt;an established mail server on the node's domain, not written from scratch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="650" y="492" width="400" height="70" as="geometry"/></mxCell>
        <mxCell id="c1017" value="Sync and replication&lt;br&gt;what this node shares, and the copies it holds for others" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="650" y="572" width="400" height="70" as="geometry"/></mxCell>
        <mxCell id="c1018" value="Containers (from the compose files, grouped by what needs them)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1110" y="110" width="520" height="20" as="geometry"/></mxCell>
        <mxCell id="c1019" value="BASE: nginx, app, postgres, redis, scheduler, horizon (queue worker)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1110" y="140" width="520" height="52" as="geometry"/></mxCell>
        <mxCell id="c1020" value="TALK: matrix, mas (sign-in for Matrix), livekit (the &quot;voice&quot; profile)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1110" y="202" width="520" height="52" as="geometry"/></mxCell>
        <mxCell id="c1021" value="COMMUNITY SIMULATION: etl (map ingestion, finished here), redis_queue, horizon at its large memory setting" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1110" y="264" width="520" height="66" as="geometry"/></mxCell>
        <mxCell id="c1022" value="DEV ONLY: vite (the &quot;dev&quot; profile)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1110" y="340" width="520" height="40" as="geometry"/></mxCell>
        <mxCell id="c1023" value="MESH OPTIONS: caddy (public overlay), headscale (tailnet), patroni with etcd and haproxy (data-tier failover)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1110" y="390" width="520" height="66" as="geometry"/></mxCell>
        <mxCell id="c1024" value="Which containers each node set truly needs is not measured yet. An Individual-only host likely drops etl and the large horizon, and may share Matrix and LiveKit. Measure on Defiant before cutting." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1110" y="466" width="520" height="90" as="geometry"/></mxCell>
        <mxCell id="c1025" value="Voyager runs the Individual set only. Defiant runs all sets today." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1110" y="566" width="520" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="3 Who sees what" id="mesh-3">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1200" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="c1001" value="A chart anyone can read: who sees what. Everything outside &quot;Me&quot; starts at None. You raise it per item and per audience, and you can lower it again. PROPOSED design." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=14;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1600" height="30" as="geometry"/></mxCell>
        <mxCell id="c1002" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40.0" y="120.0" width="720" height="720" as="geometry"/></mxCell>
        <mxCell id="c1003" value="OPEN MESH and the public: only what you publish" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=top;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250" y="130" width="300" height="20" as="geometry"/></mxCell>
        <mxCell id="c1004" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="100.0" y="180.0" width="600" height="600" as="geometry"/></mxCell>
        <mxCell id="c1005" value="COMMUNITY: what you share into it" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=top;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250" y="190" width="300" height="20" as="geometry"/></mxCell>
