      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1001" value="One address text works for mail, SIP calls and the web profile. The left part is the person. The right part is a chain of places, read from the right. Samples only." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=14;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" parent="1" vertex="1">
