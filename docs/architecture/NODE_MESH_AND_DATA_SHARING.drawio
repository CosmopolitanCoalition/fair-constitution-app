        <mxCell id="c1009" value="mecklenburg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="496" y="130" width="170" height="56" as="geometry" />
        </mxCell>
        <mxCell id="c1010" value="county community" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=9;align=center;verticalAlign=top;fontColor=#333333;" parent="1" vertex="1">
          <mxGeometry x="496" y="192" width="170" height="50" as="geometry" />
