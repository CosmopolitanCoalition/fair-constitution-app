        <mxCell id="c1014" value="country" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=9;align=center;verticalAlign=top;fontColor=#333333;" parent="1" vertex="1">
          <mxGeometry x="768" y="192" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c1015" value="earth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="874" y="130" width="100" height="56" as="geometry" />
        </mxCell>
        <mxCell id="c1016" value="planet" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=9;align=center;verticalAlign=top;fontColor=#333333;" parent="1" vertex="1">
          <mxGeometry x="874" y="192" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c1017" value="worldofstatecraft.org" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="980" y="130" width="230" height="56" as="geometry" />
        </mxCell>
        <mxCell id="c1018" value="mesh root (any TLD aliased)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=9;align=center;verticalAlign=top;fontColor=#333333;" parent="1" vertex="1">
          <mxGeometry x="980" y="192" width="230" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c1019" value="Web profile: the same text with a dot in place of the @:  &lt;b&gt;Joseph.JDSileo.mecklenburg.nc.usa.earth.worldofstatecraft.org&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;" parent="1" vertex="1">
          <mxGeometry x="60" y="245" width="1300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="c1020" value="Short forms drop the mesh root. &lt;b&gt;@earth&lt;/b&gt; means earth.worldofstatecraft.org." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;" parent="1" vertex="1">
          <mxGeometry x="60" y="268" width="1300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="c1021" value="FORMS IN USE NOW" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="60" y="310" width="600" height="22" as="geometry" />
