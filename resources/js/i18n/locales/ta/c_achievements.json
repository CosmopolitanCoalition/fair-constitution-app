{
  "achievement.ach_bog_001": "துறை வாரிய உறுப்பினராகப் பொறுப்பேற்றார் (R-18)",
  "achievement.ach_bog_002": "துறை விதியை நடைமுறைப்படுத்தினார்",
  "achievement.ach_bog_003": "துறை அறிக்கையைத் தாக்கல் செய்தார்",
  "achievement.ach_bog_004": "10 ஆண்டு கால சிவில் நியமனத்தைப் பெற்றார் (R-30)",
  "achievement.ach_bog_005": "நிர்வாக ஊழியராகப் பொறுப்பேற்றார் (R-29)",
  "achievement.ach_bog_006": "அமர்வு குறிப்புகளை வெளியிட்டார்",
  "achievement.ach_can_001": "வேட்புமனுவைப் பதிவு செய்தார்",
  "achievement.ach_can_002": "பிரச்சார விவரக்குறிப்பை வெளியிட்டார்",
  "achievement.ach_can_003": "ஆதரவு கோரினார்",
  "achievement.ach_can_004": "ஒரு அமைப்பால் ஆதரவு அளிக்கப்பட்டது (R-07)",
  "achievement.ach_can_005": "வேட்புமனு வாரியத்தால் சரிபார்க்கப்பட்டது",
  "achievement.ach_can_006": "ஆதரவு இன்றி போட்டியிட்டுப் பொறுப்பேற்றார்",
  "achievement.ach_civ_001": "பதிவு செய்யப்பட்டது",
  "achievement.ach_civ_002": "விவரக்குறிப்பு அமைக்கப்பட்டது",
  "achievement.ach_civ_003": "குடியிருப்பை அறிவித்தார்",
  "achievement.ach_civ_004": "முதல் இருப்பிடக் குறிப்பு (ping)",
  "achievement.ach_civ_005": "குடியிருப்பு உறுதி செய்யப்பட்டது — வாக்குரிமை வழங்கப்பட்டது",
  "achievement.ach_civ_006": "அக்கம்புரத்திலிருந்து கிரகம் வரை அனைத்து நிலைகளிலும் இணைக்கப்பட்டார்",
  "achievement.ach_civ_007": "இடமாற்றம் செய்து மீண்டும் இணைக்கப்பட்டார்",
  "achievement.ach_eco_001": "வரித் தாக்கல் செய்தார்",
  "achievement.ach_eco_002": "பட்ஜெட் குறித்து வாக்களித்தார்",
  "achievement.ach_eco_003": "பட்ஜெட்டை அறிமுகப்படுத்தினார்",
  "achievement.ach_eco_004": "அண்டை வீட்டாரின் உதவி கோரிக்கைக்குப் பதிலளித்தார்",
  "achievement.ach_eco_005": "சந்தையில் ஒரு பொருளைப் பட்டியலிட்டார்",
  "achievement.ach_eco_006": "வர்த்தகத்தை நிறைவு செய்தார்",
  "achievement.ach_eco_007": "வேலையை வெளியிட்டார்",
  "achievement.ach_eco_008": "ஒருவருடன் கூட்டுப் பதிவேட்டைப் பதிவு செய்தார்",
  "achievement.ach_edu_001": "குடிமைப் பயிற்சியை நிறைவு செய்தார்",
  "achievement.ach_elb_001": "தேர்தல் வாரியத்தில் பொறுப்பேற்றார்",
  "achievement.ach_elb_002": "தேர்தலைத் திட்டமிட்டார்",
  "achievement.ach_elb_003": "தேர்தலைச் சான்றளித்தார்",
  "achievement.ach_elb_004": "தொகுதியை நேரடியாக வரைந்தார்",
  "achievement.ach_elb_005": "மறு எண்ணிக்கை அல்லது தணிக்கைக்கு உத்தரவிட்டார்",
  "achievement.ach_exe_001": "ஒதுக்கப்பட்ட நிர்வாகத் துறையில் பொறுப்பேற்றார் (R-14)",
  "achievement.ach_exe_002": "நிர்வாகக் குழுவிற்குத் தேர்ந்தெடுக்கப்பட்டார் (R-15)",
  "achievement.ach_exe_003": "தனிநபர் நிர்வாகத் துறைக்குத் தேர்ந்தெடுக்கப்பட்டார் (R-16)",
  "achievement.ach_exe_004": "நிர்வாக ஆலோசகராகப் பொறுப்பேற்றார் (R-17)",
  "achievement.ach_exe_005": "நிர்வாக உத்தரவைப் பிறப்பித்தார்",
  "achievement.ach_exe_006": "வாரிய உறுப்பினர் ஒருவரைப் பரிந்துரைத்தார்",
  "achievement.ach_fed_001": "உங்கள் நிகழ்வு ஒரு சமமான நபரைச் சந்தித்தது",
  "achievement.ach_fed_002": "ஒரு நோடை இயக்கினார்",
  "achievement.ach_jud_001": "வழக்கறிஞராகப் பதிவு செய்தார் (R-21)",
  "achievement.ach_jud_002": "வழக்குத் தொடர்ந்தார்",
  "achievement.ach_jud_003": "மனு தாக்கல் செய்தார்",
  "achievement.ach_jud_004": "ஆதாரங்களைச் சமர்ப்பித்தார்",
  "achievement.ach_jud_005": "சுருக்கமான அறிக்கையைத் தாக்கல் செய்தார்",
  "achievement.ach_jud_006": "நடுவர் குழு உறுப்பினராக அழைக்கப்பட்டார் (R-22)",
  "achievement.ach_jud_007": "நியமிக்கப்பட்ட நடுவர் குழுவில் பணியாற்றினார்",
  "achievement.ach_jud_008": "நீதிபதியாகப் பொறுப்பேற்றார் (R-19/R-20)",
  "achievement.ach_jud_009": "ஒரு குழு ஒதுக்கப்பட்டது",
  "achievement.ach_jud_010": "கருத்தைத் தாக்கல் செய்தார்",
  "achievement.ach_jud_011": "அரசியலமைப்பு சார்ந்த நீதிமன்றக் கண்டுபிடிப்பை மேற்கொண்டார்",
  "achievement.ach_jud_012": "நீதித்துறை தீர்வை அமல்படுத்தினார் (Art. IV §5)",
  "achievement.ach_jur_001": "முதலில் உறுதிப்படுத்தப்பட்ட குடியிருப்பாளர்",
  "achievement.ach_jur_002": "செயல்படுத்தும் வரம்பு எட்டப்பட்டது — அரசாங்கம் தொடங்கலாம்",
  "achievement.ach_jur_003": "தொடக்கத் தேர்தல் வாரியம் பொறுப்பேற்றது",
  "achievement.ach_jur_004": "முதல் தேர்தல் திட்டமிடப்பட்டது",
  "achievement.ach_jur_005": "முதல் தேர்தல் சான்றளிக்கப்பட்டது",
  "achievement.ach_jur_006": "முதல் சட்டமன்றம் பொறுப்பேற்றது",
  "achievement.ach_jur_007": "சபாநாயகர் தேர்ந்தெடுக்கப்பட்டார்",
  "achievement.ach_jur_008": "முதல் குழு உருவாக்கப்பட்டது",
  "achievement.ach_jur_009": "முதல் மசோதா இயற்றப்பட்டது",
  "achievement.ach_jur_010": "முதல் பொதுவாக்கெடுப்பு நடைபெற்றது",
  "achievement.ach_jur_011": "முதல் மனு பொதுவாக்கெடுப்பாக மாறியது",
  "achievement.ach_jur_012": "நிர்வாகத் துறை அதிகாரப் பகிர்வு செய்யப்பட்டது",
  "achievement.ach_jur_013": "நிர்வாகத் துறை தேர்ந்தெடுக்கப்பட்ட அமைப்பாக மாற்றப்பட்டது",
  "achievement.ach_jur_014": "முதல் துறை உருவாக்கப்பட்டது",
  "achievement.ach_jur_015": "நீதித்துறை உருவாக்கப்பட்டது",
  "achievement.ach_jur_016": "முதல் வழக்கு தீர்ப்பளிக்கப்பட்டது",
  "achievement.ach_jur_017": "முதல் பொது நலக் கழகம் சான்றளிக்கப்பட்டது",
  "achievement.ach_jur_018": "தொகுதிகள் வரையப்பட்டன / உட்பிரிவு செய்யப்பட்டன",
  "achievement.ach_jur_019": "இரண்டாம் சபை பொறுப்பேற்றது (இருசபை முறை)",
  "achievement.ach_jur_020": "முழு நிறுவனங்கள் — சட்டமன்றம் + நிர்வாகத் துறை + நீதித்துறை அனைத்தும் செயல்பாட்டில் உள்ளன",
  "achievement.ach_jur_021": "ஒன்றியம் உருவாக்கப்பட்டது அல்லது எல்லை ஒப்பந்தம் செய்யப்பட்டது",
  "achievement.ach_jur_022": "அவசரகால அதிகாரம் அறிவிக்கப்பட்டது, பின்னர் 90 நாட்களுக்குள் முடிவடைந்தது",
  "achievement.ach_jur_023": "முதல் வரவுசெலவுத் திட்டம் இயற்றப்பட்டது",
  "achievement.ach_jur_024": "முதல் உதவித்தொகை வழங்கல் நிறைவடைந்தது",
  "achievement.ach_jur_025": "முதல் வருவாய் வழிமுறை நிறுவப்பட்டது",
  "achievement.ach_jur_026": "முதல் பரஸ்பர உதவி கோரிக்கைக்கு பதிலளிக்கப்பட்டது",
  "achievement.ach_leg_001": "பதவிப் பிரமாணம் செய்தது",
  "achievement.ach_leg_002": "முதல் வருகை பதிவு செய்யப்பட்டது",
  "achievement.ach_leg_003": "ஒரு மசோதாவை அறிமுகப்படுத்தினீர்கள்",
  "achievement.ach_leg_004": "சபை வாக்கெடுப்பில் பங்கேற்றீர்கள்",
  "achievement.ach_leg_005": "நீங்கள் அறிமுகப்படுத்திய மசோதா சட்டமானது",
  "achievement.ach_leg_006": "ஒரு தீர்மானத்தைக் கொண்டு வந்தீர்கள்",
  "achievement.ach_leg_007": "பொதுப் பதிவில் ஒரு அறிக்கையை அளித்தீர்கள்",
  "achievement.ach_leg_008": "உங்கள் குழு விருப்பங்களை வரிசைப்படுத்தினீர்கள்",
  "achievement.ach_leg_009": "ஒரு குழுவில் உறுப்பினராக நியமிக்கப்பட்டீர்கள் (R-11)",
  "achievement.ach_leg_010": "குழு வாக்கெடுப்பில் பங்கேற்றீர்கள்",
  "achievement.ach_leg_011": "ஒரு குழுவிற்குத் தலைமை தாங்கினீர்கள் (R-12)",
  "achievement.ach_leg_012": "மாற்றுத் தலைவராகப் பணியாற்றினீர்கள் (R-13)",
  "achievement.ach_leg_013": "சபாநாயகராகத் தேர்ந்தெடுக்கப்பட்டீர்கள் (R-10)",
  "achievement.ach_leg_014": "சமமான வாக்குகளைத் தீர்மானிக்கும் வாக்கை அளித்தீர்கள்",
  "achievement.ach_leg_015": "சிறப்புப் பெரும்பான்மை தீர்மானத்தில் வாக்களித்தீர்கள்",
  "achievement.ach_org_001": "ஒரு அமைப்பைப் பதிவு செய்தீர்கள்",
  "achievement.ach_org_002": "ஒரு அமைப்பின் முகவராக மாறினீர்கள் (R-23)",
  "achievement.ach_org_003": "ஒரு அமைப்பில் சேர்ந்தீர்கள் (R-24)",
  "achievement.ach_org_004": "ஒரு பணியாளராகப் பதிவு செய்தீர்கள் (R-25)",
  "achievement.ach_org_005": "அமைப்பின் முகவராக அங்கீகாரம் வழங்கினீர்கள்",
  "achievement.ach_org_006": "வாரியத் தேர்தலை நடத்தினீர்கள்",
  "achievement.ach_org_007": "பணியாளர் வாரியத் தேர்தலை நடத்தினீர்கள்",
  "achievement.ach_org_008": "உரிமையாளரால் தேர்ந்தெடுக்கப்பட்ட வாரிய இருக்கை (R-26)",
  "achievement.ach_org_009": "பணியாளரால் தேர்ந்தெடுக்கப்பட்ட வாரிய இருக்கை (R-27)",
  "achievement.ach_org_010": "வாரியத் தலைவர் (R-28)",
  "achievement.ach_org_011": "உரிமையை மாற்றினீர்கள்",
  "achievement.ach_org_012": "பொது↔தனியார் நிலையை மாற்றினீர்கள்",
  "achievement.ach_org_013": "பணியை பொதுப் பயன்பாட்டிற்கு வழங்கினீர்கள்",
  "achievement.ach_sys_001": "முதல் அதிகார எல்லை செயல்படுத்தப்பட்டது",
  "achievement.ach_sys_002": "100 அதிகார எல்லைகள் செயல்பாட்டில் உள்ளன",
  "achievement.ach_sys_003": "1,000 அதிகார எல்லைகள் செயல்பாட்டில் உள்ளன",
  "achievement.ach_sys_004": "1,000,000 குடியிருப்பாளர்கள் உறுதி செய்யப்பட்டனர்",
  "achievement.ach_sys_005": "முதல் சமமான கூட்டமைப்பு",
  "achievement.ach_sys_006": "அரசாங்கங்களின் முதல் ஒன்றியம்",
  "achievement.ach_sys_007": "அதிகார எல்லைப் பரப்பளவு %",
  "achievement.ach_sys_008": "பூமி எட்டப்பட்ட மைல்கற்கள் (25/50/75/100)",
  "achievement.ach_sys_009": "அனைத்து கண்டங்களும் பிரதிநிதித்துவப்படுத்தப்பட்டுள்ளன",
  "achievement.ach_vot_001": "முதல் வாக்குச்சீட்டைப் பயன்படுத்தினீர்கள்",
