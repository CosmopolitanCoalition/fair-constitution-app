/vendor/
node_modules/
npm-debug.log
yarn-error.log

# Laravel 4 specific
bootstrap/compiled.php
app/storage/

# Laravel 5 & Lumen specific
public/storage
public/hot

# Laravel 5 & Lumen specific with changed public path
public_html/storage
public_html/hot

storage/*.key
.env
Homestead.yaml
Homestead.json
/.vagrant
.phpunit.result.cache

/public/build
/storage/pail
.env.backup
.env.production
.phpactor.json
auth.json
# ...but that pattern is unanchored, and Phase N names a message catalog after
# every page folder — including Pages/Auth. Without this negation the `auth`
# namespace silently never commits, in every locale.
!resources/js/i18n/**/auth.json

# Claude session files
.claude/

# Generated doc extracts (rebuilt at session start via docs/extract_docs.py)
docs/extracted/

# ─── ETL source data — too large for git ──────────────────────────────────────
# See docs/DATA_ACQUISITION.md for how to acquire these locally.
docs/worldpop_100m_latest/
docs/geoBoundaries_repo/

# ─── ETL runtime artifacts ────────────────────────────────────────────────────
scripts/etl/progress.json
scripts/etl/*.log
scripts/etl/__pycache__/
# Supervisor + heartbeat control files (bars.json, current.json, running.json,
# failed.json, halt.json, paused_on_error.json, error_resolution.json,
# caches_warmed.json, raster_prewarm_dispatched.json, t7_dryrun*) — all
# runtime state written by the live ETL, not source. The directory itself
# is created by error_pause.py / heartbeat.py at first write.
scripts/etl/control/

# ─── Python ───────────────────────────────────────────────────────────────────
**/__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# ─── Windows ──────────────────────────────────────────────────────────────────
desktop.ini
Thumbs.db
*.ini

# ─── Protomaps PMTiles bundle (P.7) ───────────────────────────────────────────
# ~150 MB self-hostable base map; fetched via scripts/setup/fetch_protomaps.sh
# at install time, never committed.
public/maps/*.pmtiles

# ─── Video library (W-0448) ───────────────────────────────────────────────────
# The self-hosted films (54.8 GB) are never committed. MEDIA_DIR is bind-mounted
# at public/media/Subjects; the default repo-relative dirs and the mount point
# stay out of git.
/public/media/

# Locale bundles (2026-09-17): generated by scripts/i18n/bundle_locales.mjs at build/dev start.
/public/i18n/
/data/media/
/data/media-source/

# Phase K-3 — scratch output of `mas-cli config generate` (the committed dev config is config.yaml,
# carrying DEV-ONLY secrets like the repo's dev APP_KEY; deploy.sh / matrix:setup regenerate for prod)
docker/matrix/mas/config.generated.yaml
/.matrix-deploy.*/

# Live translation run state — worker heartbeats, written per chunk.
# Machine state about a run in flight, not a repo artifact.
/storage/app/i18n-run/

# Master string export — chunk files handed to an AI for translation.
# Generated by scripts/i18n/export_master.py, not a repo artifact.
/storage/app/i18n-export/

# Parallel build lanes: git worktrees kept under the repo so the Docker bind mount sees them.
/.wt/
/test-results/

# Accessibility signed-in sweep: throwaway storageState (contains a session cookie).
# Written by tests/browser/signin.mjs; never committed.
/storage/logs/a11y/
